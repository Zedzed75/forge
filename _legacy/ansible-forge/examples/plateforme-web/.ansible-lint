---
# ---------------------------------------------------------------------------
# .ansible-lint — configuration du linter Ansible
# ---------------------------------------------------------------------------
# Vérification complète du projet :
#   ansible-lint
# Le profil « production » est le plus strict : il impose les noms de modules
# complets (FQCN), un nom explicite sur chaque tâche et des rôles documentés.
#
# Fichier généré par ansible-forge à partir de forge.yml.
# Régénérez le projet plutôt que de modifier ce fichier à la main.
# ---------------------------------------------------------------------------

profile: production

exclude_paths:
  - .venv/
  - .github/

# Les règles par défaut suffisent : aucune n'est désactivée dans ce projet.
skip_list: []
