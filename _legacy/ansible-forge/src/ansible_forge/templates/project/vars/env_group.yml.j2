{% from "partials/header.j2" import file_header, section %}
---
{{ file_header(
     "inventories/" ~ env.name ~ "/group_vars/" ~ group.name ~ ".yml — variables du groupe « " ~ group.name ~ " » en « " ~ env.name ~ " »",
     [
       "Couche de précédence la plus élevée avant les variables de machine :",
       "elle ne concerne que le groupe « " ~ group.name ~ " » dans l'environnement « " ~ env.name ~ " ».",
     ]) }}
{% if variables %}
{{ section("Surcharges du groupe pour cet environnement") }}
{% for item in variables %}
{{ item.description | comment }}
{{ item.name }}:{{ item.value | yaml_assign(2) }}

{% endfor %}
{% else %}
{{ section("Surcharges du groupe pour cet environnement") }}
# Aucune surcharge définie pour ce groupe dans cet environnement.
# Les valeurs effectives viennent, par précédence croissante, de
# roles/<rôle>/defaults/main.yml, group_vars/all.yml, group_vars/{{ group.name }}.yml
# puis inventories/{{ env.name }}/group_vars/all.yml.
{% endif %}
