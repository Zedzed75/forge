{% from "partials/header.j2" import file_header %}
---
{{ file_header(
     "roles/" ~ role.name ~ "/meta/main.yml — métadonnées du rôle",
     [
       "Décrit le rôle pour Ansible Galaxy et déclare ses dépendances.",
       "Une liste dependencies vide signifie que le rôle est autonome :",
       "c'est le playbook qui décide de l'ordre d'application des rôles.",
     ]) }}
galaxy_info:
  role_name: {{ role.name }}
  author: {{ author | yaml_scalar }}
  description: {{ role.summary | yaml_scalar }}
  license: MIT
  min_ansible_version: "2.15"
  platforms:
{% for platform in platforms %}
    - name: {{ platform }}
      versions:
        - all
{% endfor %}
  galaxy_tags:
{% for tag in role.tags %}
    - {{ tag }}
{% endfor %}

# Aucune dépendance : l'ordre d'application est défini dans les playbooks.
dependencies: []
