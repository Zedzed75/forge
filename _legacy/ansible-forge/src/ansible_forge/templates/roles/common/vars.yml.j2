{% from "partials/header.j2" import file_header, var_doc %}
---
{{ file_header(
     "roles/common/vars/main.yml — variables internes du rôle common",
     [
       "Ces variables ont une précédence supérieure à group_vars : elles ne sont",
       "pas destinées à être surchargées. Elles traduisent les différences entre",
       "familles de systèmes d'exploitation.",
     ]) }}
{{ var_doc(
     "Nom du paquet fournissant la synchronisation horaire, selon la famille d'OS.",
     "Dictionnaire indexé par ansible_facts['os_family'].") }}
common_ntp_package_map:
  Debian: systemd-timesyncd
  RedHat: chrony

{{ var_doc(
     "Nom du service de synchronisation horaire, selon la famille d'OS.",
     "Dictionnaire indexé par ansible_facts['os_family'].") }}
common_ntp_service_map:
  Debian: systemd-timesyncd
  RedHat: chronyd

{{ var_doc(
     "Paquet de synchronisation horaire résolu pour la machine courante.",
     "Calculée automatiquement à partir des faits ; ne pas surcharger.") }}
common_ntp_package: {{ jstr("common_ntp_package_map[ansible_facts['os_family']]") }}

{{ var_doc(
     "Service de synchronisation horaire résolu pour la machine courante.",
     "Calculée automatiquement à partir des faits ; ne pas surcharger.") }}
common_ntp_service: {{ jstr("common_ntp_service_map[ansible_facts['os_family']]") }}
