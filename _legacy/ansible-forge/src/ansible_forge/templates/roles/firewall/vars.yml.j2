{% from "partials/header.j2" import file_header, var_doc %}
---
{{ file_header(
     "roles/firewall/vars/main.yml — variables internes du rôle firewall",
     [
       "Résolution du backend « auto » et traduction de la politique par défaut",
       "vers la cible de zone attendue par firewalld.",
     ]) }}
{{ var_doc(
     "Backend choisi lorsque firewall_backend vaut « auto », selon la famille d'OS.",
     "Dictionnaire indexé par ansible_facts['os_family'].") }}
firewall_default_backend_map:
  Debian: ufw
  RedHat: firewalld

{{ var_doc(
     "Cible de zone firewalld correspondant à chaque politique par défaut.",
     "Dictionnaire indexé par la valeur de firewall_default_incoming_policy.") }}
firewall_zone_target_map:
  deny: DROP
  reject: '%%REJECT%%'
  allow: ACCEPT

{{ var_doc(
     "Zone firewalld dans laquelle les règles sont posées.",
     "Nom d'une zone firewalld existante.") }}
firewall_zone: public

{{ var_doc(
     "Backend de pare-feu réellement utilisé sur la machine courante.",
     "Calculée automatiquement ; ne pas surcharger.") }}
firewall_effective_backend: {{ jstr("firewall_default_backend_map[ansible_facts['os_family']] if firewall_backend == 'auto' else firewall_backend") }}

{{ var_doc(
     "Cible de zone firewalld déduite de la politique par défaut.",
     "Calculée automatiquement ; ne pas surcharger.") }}
firewall_zone_target: {{ jstr("firewall_zone_target_map[firewall_default_incoming_policy]") }}
