{% raw %}
{#
  Hôte virtuel principal du projet.
  Rendu par Ansible (rôle nginx) depuis les variables nginx_*.
#}
# Fichier géré par Ansible - toute modification manuelle sera écrasée.

server {
    listen {{ nginx_listen_port }};
    listen [::]:{{ nginx_listen_port }};
    server_name {{ nginx_server_name }};

{% if nginx_enable_https %}
    # HTTPS activé : tout le trafic en clair est redirigé.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ nginx_server_name }};

    ssl_certificate {{ nginx_ssl_certificate }};
    ssl_certificate_key {{ nginx_ssl_certificate_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

{% endif %}
    root {{ nginx_document_root }};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

    # Les fichiers cachés ne sont jamais servis.
    location ~ /\. {
        deny all;
    }
}
{% endraw %}
