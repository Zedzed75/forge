{% from "partials/header.j2" import file_header %}
---
{{ file_header(
     "roles/postgresql/tasks/main.yml — serveur PostgreSQL",
     [
       "Ordre d'exécution : paquets, initialisation du cluster (RedHat),",
       "démarrage du service, réglages du serveur, rôles, bases puis règles",
       "d'authentification. Les rôles sont créés avant les bases car une base",
       "référence son propriétaire.",
       "Les mots de passe proviennent du vault : chaque entrée de",
       "postgresql_db_users nomme la variable qui le contient.",
     ]) }}
- name: Installer PostgreSQL et ses dépendances
  ansible.builtin.package:
    name: {{ jstr('postgresql_packages') }}
    state: present

- name: Initialiser le cluster PostgreSQL
  ansible.builtin.command:
    cmd: /usr/bin/postgresql-setup --initdb
    creates: {{ jstr("postgresql_config_dir ~ '/PG_VERSION'") }}
  when: ansible_facts['os_family'] == 'RedHat'

- name: Activer et démarrer le service PostgreSQL
  ansible.builtin.service:
    name: {{ jstr('postgresql_service') }}
    state: started
    enabled: true

- name: Appliquer les réglages du serveur
  community.postgresql.postgresql_set:
    name: {{ jstr('item.name') }}
    value: {{ jstr('item.value') }}
  become: true
  become_user: {{ jstr('postgresql_system_user') }}
  loop: {{ jstr('postgresql_settings') }}
  loop_control:
    label: {{ jstr('item.name') }}
  notify: Redémarrer PostgreSQL

- name: Créer les rôles de connexion
  community.postgresql.postgresql_user:
    name: {{ jstr('item.name') }}
    password: {{ jstr("lookup('vars', item.password_var)") }}
    state: present
  become: true
  become_user: {{ jstr('postgresql_system_user') }}
  loop: {{ jstr('postgresql_users_with_password') }}
  loop_control:
    label: {{ jstr('item.name') }}
  no_log: true

- name: Créer les bases de données
  community.postgresql.postgresql_db:
    name: {{ jstr('item.name') }}
    owner: {{ jstr("item.owner | default(omit, true)") }}
    encoding: {{ jstr('item.encoding') }}
    state: present
  become: true
  become_user: {{ jstr('postgresql_system_user') }}
  loop: {{ jstr('postgresql_databases') }}
  loop_control:
    label: {{ jstr('item.name') }}

- name: Accorder les privilèges déclarés
  community.postgresql.postgresql_privs:
    database: {{ jstr("item.privileges.split(':')[0]") }}
    privs: {{ jstr("item.privileges.split(':')[1]") }}
    type: database
    role: {{ jstr('item.name') }}
    state: present
  become: true
  become_user: {{ jstr('postgresql_system_user') }}
  loop: {{ jstr('postgresql_users_with_privileges') }}
  loop_control:
    label: {{ jstr('item.name') }}

- name: Déclarer les règles d'authentification supplémentaires
  community.postgresql.postgresql_pg_hba:
    dest: {{ jstr("postgresql_config_dir ~ '/pg_hba.conf'") }}
    contype: {{ jstr("item.split()[0]") }}
    databases: {{ jstr("item.split()[1]") }}
    users: {{ jstr("item.split()[2]") }}
    address: {{ jstr("item.split()[3]") }}
    method: {{ jstr("item.split()[4]") }}
    state: present
  loop: {{ jstr('postgresql_hba_entries') }}
  notify: Recharger PostgreSQL
