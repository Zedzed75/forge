{% raw %}
# Fichier géré par Ansible (rôle ssh_hardening) - modification manuelle écrasée.
#
# Ces directives sont lues après /etc/ssh/sshd_config. Sur OpenSSH, c'est la
# PREMIÈRE valeur rencontrée qui gagne : la ligne « Include » placée en tête du
# fichier principal garantit donc que ce fichier a la priorité.

# Port d'écoute du serveur.
Port {{ ssh_hardening_port }}

# Connexion directe du compte root.
PermitRootLogin {{ ssh_hardening_permit_root_login }}

# Authentification par mot de passe.
PasswordAuthentication {{ 'yes' if ssh_hardening_password_authentication else 'no' }}
KbdInteractiveAuthentication {{ 'yes' if ssh_hardening_password_authentication else 'no' }}

# Authentification par clé publique.
PubkeyAuthentication {{ 'yes' if ssh_hardening_pubkey_authentication else 'no' }}

# Transfert graphique X11.
X11Forwarding {{ 'yes' if ssh_hardening_x11_forwarding else 'no' }}

# Nombre de tentatives d'authentification par connexion.
MaxAuthTries {{ ssh_hardening_max_auth_tries }}

{% if ssh_hardening_allow_groups | length > 0 %}
# Seuls les membres de ces groupes peuvent se connecter.
AllowGroups {{ ssh_hardening_allow_groups | join(' ') }}

{% endif %}
# Réglages complémentaires de durcissement.
PermitEmptyPasswords no
IgnoreRhosts yes
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2
{% endraw %}
