# =============================================================================
# .gitignore — artefacts à ne jamais versionner
# =============================================================================
# Fichier généré par helm-forge.
# =============================================================================

# Archives produites par « helm package »
dist/
*.tgz

# Dépendances de charts, reconstruites par « helm dependency update »
charts/*/charts/
charts/*/Chart.lock

# Rendus locaux
*.rendered.yaml
rendered/

# Fichiers de values contenant des valeurs réelles : ils n'ont rien à faire
# dans le dépôt. Les secrets se gèrent hors du chart.
values-local.yaml
*.secret.yaml
secrets.yaml

# Configuration d'accès au cluster
kubeconfig
*.kubeconfig

# Éditeurs et systèmes de fichiers
.idea/
.vscode/
.DS_Store
*~
*.swp
