[#-
  Comment macros available to the templates of every plugin.

  This directory lives at the ROOT of the template repository, outside any
  `_subdirectory`: copier's Jinja loader is rooted on the repository root, so
  these macros are importable from any plugin
  (`[% import "partials/header.jinja" as header %]`) without ever being written
  into the generated project. Verified experimentally.

  They carry a cross-cutting rule from CLAUDE.md: every generated file explains
  itself — a header banner, and a comment on every variable exposed to the user.

  Today only the `ansible` templates import them; the four other domains write
  their headers inline. That is why translating this file moves the ansible
  golden trees and no others.

  file_header : banner at the top of a file.
  var_doc     : documentation of a variable (purpose + allowed values).
  section     : subtitle inside a file.
-#]
[% macro file_header(title, lines=None) %]
[[ rule() ]]
# [[ title ]]
[[ rule() ]]
[% if lines %]
[% for line in lines %]
[[ line | comment ]]
[% endfor %]
#
[% endif %]
# File generated by forge from forge.yml.
# Regenerate the project rather than editing this file by hand.
[[ rule() ]]
[% endmacro %]
[% macro var_doc(description, allowed, indent=0) %]
[[ description | comment(indent) ]]
[[ ("Allowed values: " ~ (allowed | lower_first)) | comment(indent) ]]
[%- endmacro %]
[% macro section(title, indent=0) %]
[[ " " * indent ]]# [[ title ]]
[[ " " * indent ]][[ rule(60) ]]
[%- endmacro %]
