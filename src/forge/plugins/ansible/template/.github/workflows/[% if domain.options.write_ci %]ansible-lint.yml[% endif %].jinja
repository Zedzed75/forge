[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     ".github/workflows/ansible-lint.yml — quality gate of the project",
     [
       "Replays on every push the two checks the project requires:",
       "the syntax of each environment, and ansible-lint.",
       "ansible-core does not support Windows as a control node: this workflow",
       "is the authority if you develop on Windows.",
     ]) ]]
name: ansible-lint

on:
  push:
    branches: [main]
  pull_request:

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - name: Check out the repository
        uses: actions/checkout@v4

      - name: Install Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install ansible-core and ansible-lint
        run: python -m pip install --upgrade ansible-core ansible-lint

      - name: Install the Galaxy collections
        run: ansible-galaxy collection install -r requirements.yml

[% for env in domain.env_names %]
      - name: Check the syntax of the [[ env ]] environment
        run: ansible-playbook -i inventories/[[ env ]] playbooks/site.yml --syntax-check

[% endfor %]
      - name: Run ansible-lint
        run: ansible-lint
