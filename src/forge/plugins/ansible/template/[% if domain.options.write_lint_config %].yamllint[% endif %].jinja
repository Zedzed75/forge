[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     ".yamllint — YAML style rules of the project",
     [
       "Rules aligned with the ones ansible-lint applies, so that the two tools",
       "never contradict each other. Check with: yamllint .",
     ]) ]]
extends: default

rules:
  # Generated files stay readable well beyond 80 columns.
  line-length:
    max: 160
    level: warning
  # Ansible only accepts true/false as canonical booleans.
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  # A single space is enough between the content and a trailing comment.
  comments:
    min-spaces-from-content: 1
  # File modes must be written as strings ('0644'), never in octal.
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .venv/
