[% from "partials/header.jinja" import file_header, section %]
[[ file_header(
     "ansible.cfg — Ansible configuration of the " ~ service.name ~ " project",
     [
       "This file is read automatically when ansible is run from the root of the project.",
       "The default inventory is the one of the \"" ~ domain.default_env ~ "\" environment; target another environment with -i inventories/<env>.",
     ]) ]]
[defaults]
[[ section("Where the project resources live") ]]
# Inventory used when the -i option is not given.
inventory = inventories/[[ domain.default_env ]]

# Directory of the roles shipped with the project.
roles_path = ./roles

[[ section("General behaviour") ]]
# Python interpreter used on the target machines.
# "auto_silent" lets Ansible detect the interpreter without emitting a warning.
interpreter_python = [[ domain.python_interpreter ]]

# Checks the SSH fingerprint of the target machines (keep it True in production).
host_key_checking = True

# Disables the creation of .retry files at the root of the project.
retry_files_enabled = False

# Number of machines configured in parallel.
forks = 10

# Maximum delay to establish the connection, in seconds.
timeout = 30

# Fact gathering: "smart" avoids re-gathering facts that are already known.
gathering = smart

[privilege_escalation]
[[ section("Privilege escalation") ]]
# Enables sudo by default on the tasks; every play may redefine it.
become = [[ 'True' if domain.become else 'False' ]]
become_method = sudo
become_user = root
become_ask_pass = False

[ssh_connection]
[[ section("SSH transport") ]]
# Pipelining strongly reduces the number of SSH operations per task.
# It requires "requiretty" to be disabled in /etc/sudoers on the targets.
pipelining = True

# Reuse of the SSH connections across tasks.
ssh_args = -o ControlMaster=auto -o ControlPersist=60s -o PreferredAuthentications=publickey
