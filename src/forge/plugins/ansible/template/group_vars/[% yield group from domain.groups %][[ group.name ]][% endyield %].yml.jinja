[% from "partials/header.jinja" import file_header, section %]
---
[[ file_header(
     "group_vars/" ~ group.name ~ ".yml — variables of the \"" ~ group.name ~ "\" group",
     [
       group.description or ("Variables shared by the machines of the " ~ group.name ~ " group."),
       "These values override group_vars/all.yml for this group only,",
       "in every environment.",
     ]) ]]
[[ section("Roles applied to this group") ]]
[% for role in group.roles %]
# - [[ role.name ]]: [[ role.summary ]]
[% endfor %]
#
# To override a variable of one of these roles, copy it from
# roles/<role>/defaults/main.yml, keep its comment along with it, then change
# its value below.

[% if group.variables %]
[[ section("Variables specific to the group") ]]
[% for item in group.variables %]
[[ item.description | comment ]]
[[ item.name ]]:[[ item.value | yaml_assign(2) ]]

[% endfor %]
[% else %]
[[ section("Variables specific to the group") ]]
# No variable specific to this group is defined for now.
[% endif %]
