[% from "partials/header.jinja" import file_header, section, var_doc %]
---
[[ file_header(
     "group_vars/all.yml — variables shared by the whole project",
     [
       "These values apply to every machine of every environment.",
       "They are the layer of lowest precedence after the role defaults; a file",
       "under inventories/<env>/group_vars/ overrides them.",
     ]) ]]
[[ section("Connecting to the machines") ]]
# Account Ansible uses to connect over SSH.
# Allowed values: a POSIX account name that exists on the target machines.
ansible_user: [[ domain.remote_user | yaml_scalar ]]

# SSH port of the target machines.
# Allowed values: integer from 1 to 65535.
ansible_port: [[ domain.ssh_port ]]

# Python interpreter used on the target machines.
# Allowed values: "auto_silent", "auto" or an absolute path.
ansible_python_interpreter: [[ domain.python_interpreter | yaml_scalar ]]

[[ section("Identity of the project") ]]
# Name of the project, reused in the MOTD banner and the configuration files.
# Allowed values: free-form string.
project_name: [[ service.name | yaml_scalar ]]

# Description of the project, reused in the MOTD banner.
# Allowed values: free-form string, possibly empty.
project_description: [[ service.description | yaml_scalar ]]

[% if domain.role_overrides %]
[[ section("Role settings specific to this project") ]]
# These variables override the default value of the corresponding role.
# Variables not listed here keep the value documented in
# roles/<role>/defaults/main.yml.

[% for item in domain.role_overrides %]
[[ var_doc(item.description, item.allowed) ]]
[[ item.name ]]:[[ item.value | yaml_assign(2) ]]

[% endfor %]
[% else %]
[[ section("Role settings specific to this project") ]]
# No role default is overridden at the project level.
# To override one, copy it from roles/<role>/defaults/main.yml and keep its
# comment along with it.
[% endif %]
