[% from "partials/header.jinja" import file_header, section %]
---
[[ file_header(
     "inventories/" ~ env.name ~ "/group_vars/" ~ group.name ~ ".yml — variables of the \"" ~ group.name ~ "\" group in \"" ~ env.name ~ "\"",
     [
       "Highest precedence layer before the machine variables:",
       "it only concerns the \"" ~ group.name ~ "\" group in the \"" ~ env.name ~ "\" environment.",
     ]) ]]
[% if group.variables %]
[[ section("Group overrides for this environment") ]]
[% for item in group.variables %]
[[ item.description | comment ]]
[[ item.name ]]:[[ item.value | yaml_assign(2) ]]

[% endfor %]
[% else %]
[[ section("Group overrides for this environment") ]]
# No override defined for this group in this environment.
# The effective values come, by increasing precedence, from
# roles/<role>/defaults/main.yml, group_vars/all.yml, group_vars/[[ group.name ]].yml
# then inventories/[[ env.name ]]/group_vars/all.yml.
[% endif %]
