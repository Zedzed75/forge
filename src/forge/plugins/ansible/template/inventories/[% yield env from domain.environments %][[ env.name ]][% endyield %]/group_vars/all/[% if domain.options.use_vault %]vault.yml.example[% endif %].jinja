[% from "partials/header.jinja" import file_header, section %]
---
[[ file_header(
     "inventories/" ~ env.name ~ "/group_vars/vault.yml.example — secrets template",
     [
       "CLEARTEXT TEMPLATE: holds placeholder values only.",
       "Procedure:",
       "  1. cp vault.yml.example vault.yml",
       "  2. replace the placeholder values with the real ones",
       "  3. ansible-vault encrypt vault.yml",
       "  4. run your playbooks with --ask-vault-pass (or --vault-password-file)",
       "The encrypted vault.yml file may be committed; the password, never.",
       "Convention: every secret variable is prefixed with \"vault_\" and referenced",
       "from a non-secret variable, so that the vaults stay readable.",
     ]) ]]
[[ section("Secrets of the \"" ~ env.name ~ "\" environment") ]]
[% for item in env.vault_secrets %]
[[ item.description | comment ]]
[[ item.name ]]: [[ item.placeholder | yaml_scalar ]]

[% endfor %]
# Add the other secrets of the environment here, one per line, each one
# preceded by a comment stating what it is used for.
