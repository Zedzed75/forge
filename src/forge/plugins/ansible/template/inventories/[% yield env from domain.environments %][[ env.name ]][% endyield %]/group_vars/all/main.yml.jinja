[% from "partials/header.jinja" import file_header, section %]
---
[[ file_header(
     "inventories/" ~ env.name ~ "/group_vars/all.yml — variables of the \"" ~ env.name ~ "\" environment",
     [
       "These values apply to every machine of the \"" ~ env.name ~ "\" environment",
       "and override group_vars/all.yml and group_vars/<group>.yml.",
     ]) ]]
[[ section("Identity of the environment") ]]
# Name of the current environment, usable in templates and conditions.
# Allowed values: [[ domain.env_names | join(', ') ]].
env_name: [[ env.name | yaml_scalar ]]

[% if env.vars_all %]
[[ section("Overrides specific to this environment") ]]
[% for item in env.vars_all %]
[[ item.description | comment ]]
[[ item.name ]]:[[ item.value | yaml_assign(2) ]]

[% endfor %]
[% else %]
[[ section("Overrides specific to this environment") ]]
# No override defined for this environment.
# Example: to open an extra port in "[[ env.name ]]" only, add the variable of
# the relevant role here, commented as it is in
# roles/<role>/defaults/main.yml.
[% endif %]
