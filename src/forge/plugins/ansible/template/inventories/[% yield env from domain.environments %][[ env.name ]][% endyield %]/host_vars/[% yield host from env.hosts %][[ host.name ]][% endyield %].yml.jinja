[% from "partials/header.jinja" import file_header, section %]
---
[[ file_header(
     "inventories/" ~ env.name ~ "/host_vars/" ~ host.name ~ ".yml — variables of the \"" ~ host.name ~ "\" machine",
     [
       "Highest precedence layer: these values concern this machine only and",
       "override every other one.",
     ]) ]]
[% if host.variables %]
[[ section("Variables specific to this machine") ]]
[% for item in host.variables %]
[[ item.description | comment ]]
[[ item.name ]]:[[ item.value | yaml_assign(2) ]]

[% endfor %]
[% else %]
[[ section("Variables specific to this machine") ]]
# No variable specific to this machine.
# This file is kept so that every machine has an obvious place to add its own
# settings.
[% endif %]
