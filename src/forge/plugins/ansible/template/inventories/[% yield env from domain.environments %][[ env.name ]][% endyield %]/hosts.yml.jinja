[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "Inventory of the \"" ~ env.name ~ "\" environment — " ~ service.name ~ " project",
     [
       "Lists the machines of this environment and the groups they belong to.",
       "The shared connection variables are in group_vars/all.yml;",
       "the variables of a single machine are in host_vars/<machine>.yml.",
       "Check with: ansible-inventory -i inventories/" ~ env.name ~ " --graph",
     ]) ]]
all:
  children:
[% for group in env.groups %]
[[ (group.description or ("The " ~ group.name ~ " group")) | comment(4) ]]
    # Roles applied: [[ group.role_names | join(', ') ]]
    [[ group.name ]]:
[% if group.hosts %]
      hosts:
[% for host in group.hosts %]
        [[ host.name ]]:
          # SSH connection address used by Ansible.
          ansible_host: [[ host.ansible_host | yaml_scalar ]]
[% if host.ansible_port is not none %]
          # SSH port specific to this machine.
          ansible_port: [[ host.ansible_port ]]
[% endif %]
[% if host.ansible_user is not none %]
          # SSH account specific to this machine.
          ansible_user: [[ host.ansible_user | yaml_scalar ]]
[% endif %]
[% endfor %]
[% else %]
      # No machine declared in this environment for this group.
      hosts: {}
[% endif %]

[% endfor %]
