[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "playbooks/" ~ group.name ~ ".yml — configuration of the \"" ~ group.name ~ "\" group",
     [
       group.description or ("Applies the roles of the project to the machines of the " ~ group.name ~ " group."),
       "Targeted run:",
       "  ansible-playbook -i inventories/<env> playbooks/" ~ group.name ~ ".yml",
       "Partial run by tag:",
       "  ansible-playbook -i inventories/<env> playbooks/" ~ group.name ~ ".yml --tags " ~ group.roles[0].tags[0],
     ]) ]]
- name: Apply the configuration of the "[[ group.name ]]" group
  hosts: [[ group.name ]]
  # Privilege escalation: most system tasks require it.
  become: [[ 'true' if domain.become else 'false' ]]
  # Fact gathering is needed by the roles that adapt their behaviour to the
  # detected distribution.
  gather_facts: true

  roles:
[% for role in group.roles %]
[[ role.summary | comment(4) ]]
    - role: [[ role.name ]]
      tags:
[% for tag in role.tags %]
        - [[ tag ]]
[% endfor %]

[% endfor %]
