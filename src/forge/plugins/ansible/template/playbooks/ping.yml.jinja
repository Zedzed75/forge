[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "playbooks/ping.yml — connectivity test",
     [
       "Checks that Ansible reaches and authenticates against every machine of",
       "the inventory, without changing anything. Run it before anything else:",
       "  ansible-playbook -i inventories/<env> playbooks/ping.yml",
     ]) ]]
- name: Check the connectivity of every machine
  hosts: all
  # No privilege escalation: the test must stay purely passive.
  become: false
  # No need to gather facts for a plain connection test.
  gather_facts: false

  tasks:
    - name: Answer the Ansible connectivity test
      ansible.builtin.ping:
      tags:
        - ping
        - smoke
