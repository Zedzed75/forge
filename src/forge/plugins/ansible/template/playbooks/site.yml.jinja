[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "playbooks/site.yml — entry point of the " ~ service.name ~ " project",
     [
       "Applies the configuration of every group, in the order below.",
       "Full run against one environment:",
       "  ansible-playbook -i inventories/<env> playbooks/site.yml",
       "To handle a single group, run its playbook directly,",
       "for instance playbooks/" ~ domain.groups[0].name ~ ".yml.",
     ]) ]]
[% for group in domain.groups %]
# [[ group.description or ("Machines of the " ~ group.name ~ " group") ]]
- name: Configure the "[[ group.name ]]" group
  ansible.builtin.import_playbook: [[ group.name ]].yml

[% endfor %]
