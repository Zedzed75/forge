[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "requirements.yml — Galaxy dependencies of the project",
     [
       "Install them before the first run:",
       "  ansible-galaxy collection install -r requirements.yml",
       "The roles of the project are shipped in roles/ and are therefore not listed here.",
       "",
       "Every dependency carries a version range, a floor and a ceiling.",
       "Without a ceiling, this command would install whatever Galaxy serves on the day you run it. A major released after this project was generated may have removed a module the roles below use, and the project would then break without a single one of its lines having moved.",
       "Widening a range remains your right; the consequence is then yours.",
     ]) ]]
[% if domain.collections %]
collections:
[% for collection in domain.collections %]
  # Required by the role: [[ domain.collection_users[collection.name] | join(', ') ]]
[[ ("Floor: " ~ collection.reason) | comment(2) ]]
[[ ("Ceiling: the major following " ~ collection.validated ~ ", the version forge validates the generated projects against.") | comment(2) ]]
  - name: [[ collection.name ]]
    version: "[[ collection.version ]]"
[% endfor %]
[% else %]
# No selected role needs an external collection:
# everything relies on the ansible.builtin modules.
collections: []
[% endif %]
