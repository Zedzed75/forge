[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/common/handlers/main.yml — handlers of the common role",
     [
       "Handlers run only once, at the end of the play, and only if a task has",
       "notified them.",
     ]) ]]
- name: Restart the time synchronisation service
  ansible.builtin.service:
    name: "{{ common_ntp_service }}"
    state: restarted
