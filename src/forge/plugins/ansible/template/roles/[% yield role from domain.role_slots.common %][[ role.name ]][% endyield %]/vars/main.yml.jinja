[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/common/vars/main.yml — internal variables of the common role",
     [
       "These variables have a higher precedence than group_vars: they are not",
       "meant to be overridden. They express the differences between operating",
       "system families.",
     ]) ]]
[[ var_doc(
     "Name of the package providing time synchronisation, per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
common_ntp_package_map:
  Debian: systemd-timesyncd
  RedHat: chrony

[[ var_doc(
     "Name of the time synchronisation service, per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
common_ntp_service_map:
  Debian: systemd-timesyncd
  RedHat: chronyd

[[ var_doc(
     "Time synchronisation package resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
common_ntp_package: "{{ common_ntp_package_map[ansible_facts['os_family']] }}"

[[ var_doc(
     "Time synchronisation service resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
common_ntp_service: "{{ common_ntp_service_map[ansible_facts['os_family']] }}"
