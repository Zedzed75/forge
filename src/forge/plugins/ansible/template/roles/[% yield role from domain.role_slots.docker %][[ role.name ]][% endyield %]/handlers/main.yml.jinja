[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/docker/handlers/main.yml — handlers of the docker role",
     [
       "Restarting the daemon briefly interrupts the containers that are not",
       "under an automatic restart policy.",
     ]) ]]
- name: Restart Docker
  ansible.builtin.service:
    name: docker
    state: restarted
  when: docker_service_enabled | bool
