[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/docker/tasks/repository_debian.yml — Docker repository on Debian and Ubuntu",
     [
       "The signing key is written to /etc/apt/keyrings and then referenced by",
       "the signed-by option of the repository: the key is therefore valid for",
       "that repository only, and not for every APT source.",
     ]) ]]
- name: Install the prerequisites of the Docker repository
  ansible.builtin.apt:
    name:
      - ca-certificates
      - curl
      - gnupg
    state: present
    update_cache: true

- name: Create the directory of the repository keys
  ansible.builtin.file:
    path: /etc/apt/keyrings
    state: directory
    owner: root
    group: root
    mode: "0755"

- name: Download the signing key of the Docker repository
  ansible.builtin.get_url:
    url: "{{ 'https://download.docker.com/linux/' ~ ansible_facts['distribution'] | lower ~ '/gpg' }}"
    dest: /etc/apt/keyrings/docker.asc
    owner: root
    group: root
    mode: "0644"

- name: Declare the Docker repository
  ansible.builtin.apt_repository:
    repo: >-
      deb [arch={{ docker_apt_arch }} signed-by=/etc/apt/keyrings/docker.asc]
      https://download.docker.com/linux/{{ ansible_facts['distribution'] | lower }}
      {{ ansible_facts['distribution_release'] }} {{ docker_channel }}
    filename: docker
    state: present
    update_cache: true
