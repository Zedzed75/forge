[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/docker/tasks/repository_redhat.yml — Docker repository on RHEL and derivatives",
     [
       "Docker's CentOS repository suits the whole RHEL family: the",
       "$releasever and $basearch variables are resolved by the package",
       "manager itself.",
     ]) ]]
- name: Declare the Docker repository
  ansible.builtin.yum_repository:
    name: "{{ 'docker-ce-' ~ docker_channel }}"
    description: "{{ 'Docker CE ' ~ docker_channel }}"
    baseurl: "{{ 'https://download.docker.com/linux/centos/$releasever/$basearch/' ~ docker_channel }}"
    gpgkey: https://download.docker.com/linux/centos/gpg
    gpgcheck: true
    enabled: true
    state: present
