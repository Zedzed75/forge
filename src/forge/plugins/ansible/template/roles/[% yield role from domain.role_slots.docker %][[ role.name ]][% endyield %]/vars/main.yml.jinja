[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/docker/vars/main.yml — internal variables of the docker role",
     [
       "Mapping between the Ansible architecture and the APT one, and list of",
       "the packages to install according to the chosen options.",
     ]) ]]
[[ var_doc(
     "Mapping between the architecture reported by Ansible and the one APT expects.",
     "Dictionary indexed by ansible_facts['architecture'].") ]]
docker_arch_map:
  x86_64: amd64
  aarch64: arm64
  armv7l: armhf

[[ var_doc(
     "Configuration directory of the Docker daemon.",
     "The same on every supported distribution.") ]]
docker_config_dir: /etc/docker

[[ var_doc(
     "Packages installed in every case.",
     "List of package names from the official Docker repository.") ]]
docker_base_packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-buildx-plugin

[[ var_doc(
     "APT architecture resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
docker_apt_arch: "{{ docker_arch_map.get(ansible_facts['architecture'], ansible_facts['architecture']) }}"

[[ var_doc(
     "Final list of the packages, Compose plugin included if requested.",
     "Computed automatically; do not override.") ]]
docker_packages: "{{ docker_base_packages + (['docker-compose-plugin'] if docker_install_compose_plugin else []) }}"
