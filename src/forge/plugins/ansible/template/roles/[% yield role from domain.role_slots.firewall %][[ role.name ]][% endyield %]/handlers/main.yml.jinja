[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/firewall/handlers/main.yml — handlers of the firewall role",
     [
       "A single handler covers both implementations: ufw and firewalld alike",
       "expose a \"reload\" action through their systemd unit.",
     ]) ]]
- name: Reload the firewall
  ansible.builtin.service:
    name: "{{ firewall_effective_backend }}"
    state: reloaded
  when: firewall_enabled | bool
