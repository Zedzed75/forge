[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/firewall/vars/main.yml — internal variables of the firewall role",
     [
       "Resolution of the \"auto\" backend, and translation of the default policy",
       "into the zone target firewalld expects.",
     ]) ]]
[[ var_doc(
     "Backend chosen when firewall_backend is \"auto\", per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
firewall_default_backend_map:
  Debian: ufw
  RedHat: firewalld

[[ var_doc(
     "firewalld zone target matching each default policy.",
     "Dictionary indexed by the value of firewall_default_incoming_policy.") ]]
firewall_zone_target_map:
  deny: DROP
  reject: '%%REJECT%%'
  allow: ACCEPT

[[ var_doc(
     "firewalld zone the rules are set in.",
     "Name of an existing firewalld zone.") ]]
firewall_zone: public

[[ var_doc(
     "Firewall backend actually used on the current machine.",
     "Computed automatically; do not override.") ]]
firewall_effective_backend: "{{ firewall_default_backend_map[ansible_facts['os_family']] if firewall_backend == 'auto' else firewall_backend }}"

[[ var_doc(
     "firewalld zone target derived from the default policy.",
     "Computed automatically; do not override.") ]]
firewall_zone_target: "{{ firewall_zone_target_map[firewall_default_incoming_policy] }}"
