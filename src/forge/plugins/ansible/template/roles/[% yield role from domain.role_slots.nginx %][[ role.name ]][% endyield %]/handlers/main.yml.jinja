[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/nginx/handlers/main.yml — handlers of the nginx role",
     [
       "\"Reload nginx\" is enough for a configuration change: the connection of",
       "the clients in flight is not interrupted. The full restart is reserved",
       "for a change of binary or of module.",
     ]) ]]
- name: Reload nginx
  ansible.builtin.service:
    name: nginx
    state: reloaded

- name: Restart nginx
  ansible.builtin.service:
    name: nginx
    state: restarted
