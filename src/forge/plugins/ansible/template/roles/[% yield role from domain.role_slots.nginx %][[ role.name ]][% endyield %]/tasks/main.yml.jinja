[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/nginx/tasks/main.yml — nginx web server",
     [
       "Order of execution: installation, global configuration, document root,",
       "virtual host, removal of the default site, service activation. The",
       "configuration files are validated by \"nginx -t\" before being installed:",
       "a syntax error does not interrupt the service already in place.",
     ]) ]]
- name: Install nginx
  ansible.builtin.package:
    name: nginx
    state: present

- name: Create the document root
  ansible.builtin.file:
    path: "{{ nginx_document_root }}"
    state: directory
    owner: "{{ nginx_user }}"
    group: "{{ nginx_user }}"
    mode: "0755"

- name: Deploy the global nginx configuration
  ansible.builtin.template:
    src: nginx.conf.j2
    dest: "{{ nginx_config_dir ~ '/nginx.conf' }}"
    owner: root
    group: root
    mode: "0644"
    validate: nginx -t -c %s
  notify: Reload nginx

- name: Deploy the main virtual host
  ansible.builtin.template:
    src: vhost.conf.j2
    dest: "{{ nginx_config_dir ~ '/conf.d/' ~ nginx_server_name ~ '.conf' }}"
    owner: root
    group: root
    mode: "0644"
  notify: Reload nginx

- name: Disable the default site of the distribution
  ansible.builtin.file:
    path: "{{ nginx_default_site_path }}"
    state: absent
  when:
    - nginx_remove_default_site | bool
    - nginx_default_site_path | length > 0
  notify: Reload nginx

- name: Enable and start the nginx service
  ansible.builtin.service:
    name: nginx
    state: started
    enabled: true
