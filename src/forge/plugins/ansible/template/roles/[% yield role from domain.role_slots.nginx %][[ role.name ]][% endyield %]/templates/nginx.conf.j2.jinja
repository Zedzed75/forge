{#
  Global nginx configuration.
  Rendered by Ansible (nginx role) and validated by "nginx -t" before install.
#}
# File managed by Ansible - any manual change will be overwritten.

user {{ nginx_user }};
worker_processes {{ nginx_worker_processes }};
pid /run/nginx.pid;

events {
    # Maximum number of simultaneous connections per worker.
    worker_connections 1024;
}

http {
    # MIME types and default type.
    include {{ nginx_config_dir }}/mime.types;
    default_type application/octet-stream;

    # Static file sending optimisations.
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    # Maximum accepted size for a request body.
    client_max_body_size {{ nginx_client_max_body_size }};

    # Hides the nginx version number from the responses.
    server_tokens off;

    # Logs.
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # Compression of the textual responses.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    # Virtual hosts deployed by Ansible.
    include {{ nginx_config_dir }}/conf.d/*.conf;
}
