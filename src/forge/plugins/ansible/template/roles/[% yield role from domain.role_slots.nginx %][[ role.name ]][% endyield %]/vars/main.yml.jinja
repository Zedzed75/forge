[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/nginx/vars/main.yml — internal variables of the nginx role",
     [
       "Differences between system families: service account and location of",
       "the default site of the distribution.",
     ]) ]]
[[ var_doc(
     "System account the nginx workers run under, per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
nginx_user_map:
  Debian: www-data
  RedHat: nginx

[[ var_doc(
     "Path of the default site shipped by the distribution; empty if there is none.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
nginx_default_site_map:
  Debian: /etc/nginx/sites-enabled/default
  RedHat: ''

[[ var_doc(
     "Configuration directory of nginx.",
     "The same on every supported distribution.") ]]
nginx_config_dir: /etc/nginx

[[ var_doc(
     "Service account resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
nginx_user: "{{ nginx_user_map[ansible_facts['os_family']] }}"

[[ var_doc(
     "Path of the default site resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
nginx_default_site_path: "{{ nginx_default_site_map[ansible_facts['os_family']] }}"
