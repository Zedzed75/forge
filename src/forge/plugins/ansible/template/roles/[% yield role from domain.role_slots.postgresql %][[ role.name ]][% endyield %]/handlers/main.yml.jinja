[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/postgresql/handlers/main.yml — handlers du rôle postgresql",
     [
       "Un changement de pg_hba.conf ne demande qu'un rechargement ; un",
       "changement de paramètre du serveur peut exiger un redémarrage complet.",
     ]) ]]
- name: Recharger PostgreSQL
  ansible.builtin.service:
    name: "{{ postgresql_service }}"
    state: reloaded

- name: Redémarrer PostgreSQL
  ansible.builtin.service:
    name: "{{ postgresql_service }}"
    state: restarted
