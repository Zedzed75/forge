[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/postgresql/handlers/main.yml — handlers of the postgresql role",
     [
       "A change to pg_hba.conf only asks for a reload; a change to a server",
       "parameter may require a full restart.",
     ]) ]]
- name: Reload PostgreSQL
  ansible.builtin.service:
    name: "{{ postgresql_service }}"
    state: reloaded

- name: Restart PostgreSQL
  ansible.builtin.service:
    name: "{{ postgresql_service }}"
    state: restarted
