[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/postgresql/tasks/main.yml — PostgreSQL server",
     [
       "Order of execution: packages, cluster initialisation (RedHat), service",
       "start, server settings, roles, databases, then authentication rules.",
       "The roles are created before the databases because a database",
       "references its owner.",
       "The passwords come from the vault: every entry of postgresql_db_users",
       "names the variable that holds it.",
     ]) ]]
- name: Install PostgreSQL and its dependencies
  ansible.builtin.package:
    name: "{{ postgresql_packages }}"
    state: present

- name: Initialise the PostgreSQL cluster
  ansible.builtin.command:
    cmd: /usr/bin/postgresql-setup --initdb
    creates: "{{ postgresql_config_dir ~ '/PG_VERSION' }}"
  when: ansible_facts['os_family'] == 'RedHat'

- name: Enable and start the PostgreSQL service
  ansible.builtin.service:
    name: "{{ postgresql_service }}"
    state: started
    enabled: true

# Requires community.postgresql >= 3.13.0: `postgresql_alter_system` appeared
# there, and replaced `postgresql_set`, removed in 5.0.0. The module writes to
# postgresql.auto.conf then reloads the configuration; the parameters that
# require a restart go through the handler below.
# `value` is mandatory and typed as a string, hence the `| string` applied to
# the numeric values in vars/main.yml.
- name: Apply the server settings
  community.postgresql.postgresql_alter_system:
    param: "{{ item.name }}"
    value: "{{ item.value }}"
  become: true
  become_user: "{{ postgresql_system_user }}"
  loop: "{{ postgresql_settings }}"
  loop_control:
    label: "{{ item.name }}"
  notify: Restart PostgreSQL

- name: Create the login roles
  community.postgresql.postgresql_user:
    name: "{{ item.name }}"
    password: "{{ lookup('vars', item.password_var) }}"
    state: present
  become: true
  become_user: "{{ postgresql_system_user }}"
  loop: "{{ postgresql_users_with_password }}"
  loop_control:
    label: "{{ item.name }}"
  no_log: true

- name: Create the databases
  community.postgresql.postgresql_db:
    name: "{{ item.name }}"
    owner: "{{ item.owner | default(omit, true) }}"
    encoding: "{{ item.encoding }}"
    state: present
  become: true
  become_user: "{{ postgresql_system_user }}"
  loop: "{{ postgresql_databases }}"
  loop_control:
    label: "{{ item.name }}"

- name: Grant the declared privileges
  community.postgresql.postgresql_privs:
    database: "{{ item.privileges.split(':')[0] }}"
    privs: "{{ item.privileges.split(':')[1] }}"
    type: database
    role: "{{ item.name }}"
    state: present
  become: true
  become_user: "{{ postgresql_system_user }}"
  loop: "{{ postgresql_users_with_privileges }}"
  loop_control:
    label: "{{ item.name }}"

- name: Declare the additional authentication rules
  community.postgresql.postgresql_pg_hba:
    dest: "{{ postgresql_config_dir ~ '/pg_hba.conf' }}"
    contype: "{{ item.split()[0] }}"
    databases: "{{ item.split()[1] }}"
    users: "{{ item.split()[2] }}"
    address: "{{ item.split()[3] }}"
    method: "{{ item.split()[4] }}"
    state: present
  loop: "{{ postgresql_hba_entries }}"
  notify: Reload PostgreSQL
