[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/postgresql/vars/main.yml — internal variables of the postgresql role",
     [
       "Locations and package names differ a lot between Debian and RedHat. The",
       "derived lists avoid repeating the same Jinja filters in several tasks.",
     ]) ]]
[[ var_doc(
     "Packages to install, per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
postgresql_packages_map:
  Debian:
    - "{{ 'postgresql-' ~ postgresql_version }}"
    - postgresql-client
    - python3-psycopg2
  RedHat:
    - postgresql-server
    - postgresql
    - python3-psycopg2

[[ var_doc(
     "Name of the service, per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
postgresql_service_map:
  Debian: postgresql
  RedHat: postgresql

[[ var_doc(
     "Directory holding postgresql.conf and pg_hba.conf, per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
postgresql_config_dir_map:
  Debian: "{{ '/etc/postgresql/' ~ postgresql_version ~ '/main' }}"
  RedHat: /var/lib/pgsql/data

[[ var_doc(
     "System account owning the cluster, used for the administration commands.",
     "POSIX account created by the PostgreSQL package.") ]]
postgresql_system_user: postgres

[[ var_doc(
     "Packages resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
postgresql_packages: "{{ postgresql_packages_map[ansible_facts['os_family']] }}"

[[ var_doc(
     "Service resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
postgresql_service: "{{ postgresql_service_map[ansible_facts['os_family']] }}"

[[ var_doc(
     "Configuration directory resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
postgresql_config_dir: "{{ postgresql_config_dir_map[ansible_facts['os_family']] }}"

[[ var_doc(
     "Parameters applied to the server, built from the options of the role.",
     "Computed automatically; do not override.") ]]
postgresql_settings:
  - name: listen_addresses
    value: "{{ postgresql_listen_addresses }}"
  - name: port
    value: "{{ postgresql_port | string }}"
  - name: max_connections
    value: "{{ postgresql_max_connections | string }}"

[[ var_doc(
     "Roles that have a password variable filled in.",
     "Computed automatically; do not override.") ]]
postgresql_users_with_password: "{{ postgresql_db_users | selectattr('password_var') | list }}"

[[ var_doc(
     "Roles for which explicit privileges are requested.",
     "Computed automatically; do not override.") ]]
postgresql_users_with_privileges: "{{ postgresql_db_users | selectattr('privileges') | list }}"
