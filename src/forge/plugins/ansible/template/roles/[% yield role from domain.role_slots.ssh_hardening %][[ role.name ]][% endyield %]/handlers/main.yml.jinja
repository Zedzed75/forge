[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/ssh_hardening/handlers/main.yml — handlers of the ssh_hardening role",
     [
       "The restart only happens after the configuration has been validated by",
       "\"sshd -t\": the connections already established are not interrupted.",
     ]) ]]
- name: Restart the SSH service
  ansible.builtin.service:
    name: "{{ ssh_hardening_service }}"
    state: restarted
