[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/ssh_hardening/tasks/main.yml — hardening of the OpenSSH server",
     [
       "The directives are written to a separate file under",
       "/etc/ssh/sshd_config.d/: the configuration shipped by the distribution",
       "stays intact and the hardening is removed by deleting a single file.",
       "Every write is validated by \"sshd -t\": a syntax error cannot cut off",
       "SSH access to the machine.",
     ]) ]]
- name: Install the OpenSSH server
  ansible.builtin.package:
    name: "{{ ssh_hardening_package }}"
    state: present

- name: Create the directory of the additional configuration files
  ansible.builtin.file:
    path: "{{ ssh_hardening_dropin_dir }}"
    state: directory
    owner: root
    group: root
    mode: "0755"

- name: Make sure sshd reads the additional configuration files
  ansible.builtin.lineinfile:
    path: "{{ ssh_hardening_config_file }}"
    line: "{{ 'Include ' ~ ssh_hardening_dropin_dir ~ '/*.conf' }}"
    insertbefore: BOF
    state: present
    owner: root
    group: root
    mode: "0644"
    validate: /usr/sbin/sshd -t -f %s
  notify: Restart the SSH service

- name: Deploy the hardening directives
  ansible.builtin.template:
    src: hardening.conf.j2
    dest: "{{ ssh_hardening_dropin_dir ~ '/' ~ ssh_hardening_dropin_file }}"
    owner: root
    group: root
    mode: "0600"
    validate: /usr/sbin/sshd -t -f %s
  notify: Restart the SSH service

- name: Enable and start the SSH service
  ansible.builtin.service:
    name: "{{ ssh_hardening_service }}"
    state: started
    enabled: true
