[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/ssh_hardening/vars/main.yml — variables internes du rôle ssh_hardening",
     [
       "Le paquet et le service OpenSSH ne portent pas le même nom selon la",
       "famille de système.",
     ]) ]]
[[ var_doc(
     "Nom du paquet fournissant le serveur OpenSSH, selon la famille d'OS.",
     "Dictionnaire indexé par ansible_facts['os_family'].") ]]
ssh_hardening_package_map:
  Debian: openssh-server
  RedHat: openssh-server

[[ var_doc(
     "Nom du service SSH, selon la famille d'OS.",
     "Dictionnaire indexé par ansible_facts['os_family'].") ]]
ssh_hardening_service_map:
  Debian: ssh
  RedHat: sshd

[[ var_doc(
     "Fichier de configuration principal de sshd.",
     "Identique sur toutes les distributions supportées.") ]]
ssh_hardening_config_file: /etc/ssh/sshd_config

[[ var_doc(
     "Répertoire des fichiers de configuration additionnels de sshd.",
     "Identique sur toutes les distributions supportées.") ]]
ssh_hardening_dropin_dir: /etc/ssh/sshd_config.d

[[ var_doc(
     "Nom du fichier déposé par ce rôle. Le préfixe numérique fixe l'ordre de lecture.",
     "Nom de fichier se terminant par .conf.") ]]
ssh_hardening_dropin_file: 99-ansible-forge.conf

[[ var_doc(
     "Paquet OpenSSH résolu pour la machine courante.",
     "Calculée automatiquement à partir des faits ; ne pas surcharger.") ]]
ssh_hardening_package: "{{ ssh_hardening_package_map[ansible_facts['os_family']] }}"

[[ var_doc(
     "Service SSH résolu pour la machine courante.",
     "Calculée automatiquement à partir des faits ; ne pas surcharger.") ]]
ssh_hardening_service: "{{ ssh_hardening_service_map[ansible_facts['os_family']] }}"
