[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/ssh_hardening/vars/main.yml — internal variables of the ssh_hardening role",
     [
       "The OpenSSH package and service do not carry the same name from one",
       "system family to the other.",
     ]) ]]
[[ var_doc(
     "Name of the package providing the OpenSSH server, per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
ssh_hardening_package_map:
  Debian: openssh-server
  RedHat: openssh-server

[[ var_doc(
     "Name of the SSH service, per OS family.",
     "Dictionary indexed by ansible_facts['os_family'].") ]]
ssh_hardening_service_map:
  Debian: ssh
  RedHat: sshd

[[ var_doc(
     "Main configuration file of sshd.",
     "The same on every supported distribution.") ]]
ssh_hardening_config_file: /etc/ssh/sshd_config

[[ var_doc(
     "Directory of the additional configuration files of sshd.",
     "The same on every supported distribution.") ]]
ssh_hardening_dropin_dir: /etc/ssh/sshd_config.d

[[ var_doc(
     "Name of the file this role writes. The numeric prefix fixes the reading "
     "order. The name carries the one of the original tool, and that is "
     "deliberate: changing it would leave the old file in place on the machines "
     "already managed, and two contradictory drop-ins would coexist without "
     "anything signalling it.",
     "File name ending in .conf.") ]]
ssh_hardening_dropin_file: 99-ansible-forge.conf

[[ var_doc(
     "OpenSSH package resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
ssh_hardening_package: "{{ ssh_hardening_package_map[ansible_facts['os_family']] }}"

[[ var_doc(
     "SSH service resolved for the current machine.",
     "Computed automatically from the facts; do not override.") ]]
ssh_hardening_service: "{{ ssh_hardening_service_map[ansible_facts['os_family']] }}"
