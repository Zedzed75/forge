[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/users/tasks/main.yml — comptes locaux, sudo et clés SSH",
     [
       "Ordre d'exécution : groupes secondaires, comptes, clés autorisées, puis",
       "règles sudo. Une liste users_accounts vide rend le rôle inopérant :",
       "toutes les tâches bouclent alors sur zéro élément.",
     ]) ]]
- name: Créer les groupes secondaires déclarés
  ansible.builtin.group:
    name: "{{ item }}"
    state: present
  loop: "{{ users_secondary_groups }}"

- name: Gérer les comptes locaux
  ansible.builtin.user:
    name: "{{ item.name }}"
    groups: "{{ item.groups }}"
    append: true
    shell: "{{ item.shell }}"
    state: "{{ item.state }}"
    create_home: true
    remove: "{{ users_remove_absent_home if item.state == 'absent' else omit }}"
  loop: "{{ users_accounts }}"
  loop_control:
    label: "{{ item.name }}"

- name: Installer les clés publiques SSH autorisées
  ansible.posix.authorized_key:
    user: "{{ item.name }}"
    key: "{{ item.ssh_public_key }}"
    state: present
    exclusive: false
  loop: "{{ users_key_accounts }}"
  loop_control:
    label: "{{ item.name }}"

- name: Déployer les règles sudo des comptes autorisés
  ansible.builtin.template:
    src: sudoers.j2
    dest: "{{ '/etc/sudoers.d/' ~ users_sudoers_file }}"
    owner: root
    group: root
    mode: "0440"
    validate: visudo -cf %s
  when:
    - users_manage_sudoers | bool
    - users_sudo_accounts | length > 0

- name: Retirer le fichier sudoers lorsqu'aucun compte n'en a besoin
  ansible.builtin.file:
    path: "{{ '/etc/sudoers.d/' ~ users_sudoers_file }}"
    state: absent
  when:
    - users_manage_sudoers | bool
    - users_sudo_accounts | length == 0
