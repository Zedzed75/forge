[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/users/vars/main.yml — internal variables of the users role",
     [
       "Lists derived from users_accounts. They avoid repeating the same Jinja",
       "filters in several tasks and in the sudoers template.",
     ]) ]]
[[ var_doc(
     "Name of the file written to /etc/sudoers.d. The name carries the one of "
     "the original tool, and that is deliberate: changing it would leave the "
     "old sudoers file in place on the machines already managed.",
     "File name without a dot or a tilde, a constraint of sudo.") ]]
users_sudoers_file: 90-ansible-forge

[[ var_doc(
     "Secondary groups to create before the accounts.",
     "Computed from users_accounts; do not override.") ]]
users_secondary_groups: "{{ users_accounts | selectattr('state', 'eq', 'present') | map(attribute='groups') | flatten | unique | sort | list }}"

[[ var_doc(
     "Present accounts that have a public key to install.",
     "Computed from users_accounts; do not override.") ]]
users_key_accounts: "{{ users_accounts | selectattr('state', 'eq', 'present') | selectattr('ssh_public_key') | list }}"

[[ var_doc(
     "Names of the present accounts that have sudo access.",
     "Computed from users_accounts; do not override.") ]]
users_sudo_accounts: "{{ users_accounts | selectattr('state', 'eq', 'present') | selectattr('sudo') | map(attribute='name') | list }}"
