[% from "partials/header.jinja" import file_header, var_doc %]
---
[[ file_header(
     "roles/" ~ role.name ~ "/defaults/main.yml — default values of the role",
     [
       role.summary,
       "These values have the lowest precedence: any group_vars or host_vars",
       "file overrides them. Prefer changing them there rather than here, so",
       "that the role stays reusable as it is.",
     ]) ]]
[% for option in role.options %]
[[ var_doc(option.description, option.allowed) ]]
[[ option.var_name ]]:[[ option.default | yaml_assign(2) ]]

[% endfor %]
