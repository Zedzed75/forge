[% from "partials/header.jinja" import file_header %]
---
[[ file_header(
     "roles/" ~ role.name ~ "/meta/main.yml — metadata of the role",
     [
       "Describes the role for Ansible Galaxy and declares its dependencies.",
       "An empty dependencies list means the role stands on its own:",
       "the playbook is what decides in which order the roles are applied.",
     ]) ]]
galaxy_info:
  role_name: [[ role.name ]]
  author: [[ domain.author | yaml_scalar ]]
  description: [[ role.summary | yaml_scalar ]]
  license: MIT
  min_ansible_version: "2.15"
  platforms:
[% for platform in role.platforms %]
    - name: [[ platform ]]
      versions:
        - all
[% endfor %]
  galaxy_tags:
[% for tag in role.tags %]
    - [[ tag ]]
[% endfor %]

# No dependency: the order of application is defined in the playbooks.
dependencies: []
