---
[[ rule() ]]
# [[ w.name ]] ([[ w.kind ]] [[ w.kind | widget_symbol ]]) — environment [[ e.name ]]
[[ rule() ]]
[[ (domain.greeting ~ ", this file describes one widget in one given environment.
It is generated by the demo domain, whose only reason to exist is to exercise
nested yield tags: one yield on the environment directory, another one on the
file name of the widget.") | comment ]]
#
# Generated by forge — do not edit by hand: edit forge.yml, then run
# `forge generate` again.
[[ rule() ]]

# Name of the service, taken as is across every domain.
service: [[ service.name | yaml_scalar ]]

# Target environment. Possible values: those of service.environments.
environment: [[ e.name | yaml_scalar ]]

# True only for the environment marked production: true in forge.yml.
production: [[ e.production | yaml_scalar ]]

# Identity of the widget, as declared in the demo: section of forge.yml.
widget:
  # Name of the widget; also used as the name of this file.
  name: [[ w.name ]]
  # Kind of widget. Possible values: gauge, counter, log.
  kind: [[ w.kind ]]
  # A detailed widget also produces a file under widgets/<name>/.
  detailed: [[ w.detailed | yaml_scalar ]]

# Shared business labels, copied from service.labels.
labels:[[ service.labels | yaml_value(2) ]]
