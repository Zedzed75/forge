---
[[ rule() ]]
# Detail of widget [[ w.name ]]
[[ rule() ]]
[[ "This file only exists for widgets marked detailed: true. The path segment
carrying the yield then renders empty, and copier writes nothing: that is how a
[% if %] acts as a file filter (MIGRATION.md §2.1)." | comment ]]
[[ rule() ]]

# Name of the detailed widget.
name: [[ w.name ]]

# Kind of widget. Possible values: gauge, counter, log.
kind: [[ w.kind ]]

# Environments in which this widget is materialised.
environments:
[% for e in domain.environments %]
  - [[ e.name ]]
[% endfor %]

# Raw representation of the widget, as passed to copier.
raw:
[[ w | to_yaml(2) ]]
