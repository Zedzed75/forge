# =============================================================================
# .gitignore — artefacts that must never be versioned
# =============================================================================
# File generated by forge.
# =============================================================================

# Archives produced by "helm package"
dist/
*.tgz

# Chart dependencies, rebuilt by "helm dependency update"
charts/*/charts/
charts/*/Chart.lock

# Local renders
*.rendered.yaml
rendered/

# Values files containing real values: they have no business being in the
# repository. Secrets are managed outside the chart.
values-local.yaml
*.secret.yaml
secrets.yaml

# Cluster access configuration
kubeconfig
*.kubeconfig

# Editors and file systems
.idea/
.vscode/
.DS_Store
*~
*.swp
