# =============================================================================
# Makefile — everyday operations on the "[[ service.name ]]" chart
# =============================================================================
# File generated by forge.
#
# Every target accepts the ENV variable, which selects the environment and its
# namespace:
#
#   make lint
#   make template ENV=[[ domain.environments[0].name ]]
#   make validate ENV=[[ domain.environments[-1].name ]]
#   make install  ENV=[[ domain.environments[0].name ]]
#
# The equivalent raw helm commands appear in the README, for the environments
# that have no make.
# =============================================================================

CHART           := charts/[[ service.name ]]
RELEASE         := [[ service.name ]]
KUBE_VERSION    := [[ domain.kubernetes.full_version ]]
ENVIRONMENTS    := [% for env in domain.environments %][[ env.name ]][% if not loop.last %] [% endif %][% endfor %]

# Default environment. Override it with ENV=<name> on the command line.
ENV             ?= [[ domain.environments[0].name ]]

# Namespace associated with each environment, frozen at generation time.
[% for env in domain.environments %]
NAMESPACE_[[ env.name ]] := [[ env.namespace ]]
[% endfor %]
NAMESPACE       := $(NAMESPACE_$(ENV))

# Layering of the values files: the last one wins.
VALUES          := --values $(CHART)/values.yaml --values $(CHART)/values-$(ENV).yaml

.DEFAULT_GOAL := help
.PHONY: help lint template validate validate-all install upgrade uninstall diff test package clean

help: ## Displays this help
	@echo "Available targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'
	@echo ""
	@echo "Environments: $(ENVIRONMENTS)  (current: $(ENV) -> namespace $(NAMESPACE))"

check-env: ## Checks that ENV designates a known environment
	@if [ -z "$(NAMESPACE)" ]; then \
		echo "ENV='$(ENV)' unknown. Accepted values: $(ENVIRONMENTS)"; \
		exit 1; \
	fi

lint: ## Static analysis of the chart for each environment
	@for env in $(ENVIRONMENTS); do \
		echo "--- helm lint ($$env) ---"; \
		helm lint $(CHART) \
			--values $(CHART)/values.yaml \
			--values $(CHART)/values-$$env.yaml || exit 1; \
	done

template: check-env ## Renders the manifests of the ENV environment on standard output
	@helm template $(RELEASE) $(CHART) \
		--namespace $(NAMESPACE) $(VALUES)

validate: check-env ## Renders then validates the manifests of ENV with kubeconform
	@echo "--- kubeconform ($(ENV), Kubernetes $(KUBE_VERSION)) ---"
	@helm template $(RELEASE) $(CHART) \
		--namespace $(NAMESPACE) $(VALUES) | \
		kubeconform -strict -summary \
			-kubernetes-version $(KUBE_VERSION) \
			-schema-location default -

validate-all: ## Validates every environment
	@for env in $(ENVIRONMENTS); do \
		$(MAKE) --no-print-directory validate ENV=$$env || exit 1; \
	done

install: check-env ## Installs or updates the release in the namespace of ENV
	helm upgrade --install $(RELEASE) $(CHART) \
		--namespace $(NAMESPACE) --create-namespace $(VALUES) \
		--wait --timeout 5m

upgrade: install ## Alias of install (helm upgrade --install)

diff: check-env ## Shows the divergence between the release in place and the local chart
	@helm diff upgrade $(RELEASE) $(CHART) \
		--namespace $(NAMESPACE) $(VALUES) || \
		echo "The helm-diff plugin is absent: helm plugin install https://github.com/databus23/helm-diff"

test: check-env ## Runs the tests embedded in the chart
	helm test $(RELEASE) --namespace $(NAMESPACE)

uninstall: check-env ## Deletes the release of the ENV environment
	helm uninstall $(RELEASE) --namespace $(NAMESPACE)

package: ## Builds the .tgz archive of the chart
	helm package $(CHART) --destination dist/

clean: ## Deletes the local artefacts
	rm -rf dist/
