# =============================================================================
# Chart.yaml — metadata of the "[[ service.name ]]" Helm chart
# =============================================================================
# File generated by forge. Describes the identity of the chart: its name, its
# version, the version of the packaged application and the Kubernetes versions
# it is supported on.
#
# Two distinct versions live here, do not confuse them:
#   - version    : version of the chart itself, to be bumped on every change to
#                  the templates or to the default values;
#   - appVersion : version of the deployed application, which serves as the
#                  default image tag when no tag is given in the values.
# =============================================================================

apiVersion: v2
name: [[ service.name ]]
description: [[ service.description | yaml_scalar ]]

# "application" designates a deployable chart, as opposed to "library" which
# only contains reusable helpers and does not install.
type: application

# Version of the chart, in the strict SemVer format Helm requires.
version: [[ domain.chart_version ]]

# Version of the application. Always quoted: without the quotes, a value such
# as 1.10 would be read back as a decimal number and lose its trailing zero.
appVersion: [[ domain.app_version | yaml_scalar ]]

# Accepted Kubernetes versions. The -0 suffix allows versions carrying a
# distribution suffix, for example v[[ domain.kubernetes.version ]].0-eks-1;
# without it, Helm would refuse to install on those clusters.
kubeVersion: "[[ domain.kubernetes.kube_version_constraint ]]"

maintainers:
  - name: [[ domain.maintainer_name | yaml_scalar ]]
    email: [[ domain.maintainer_email ]]
