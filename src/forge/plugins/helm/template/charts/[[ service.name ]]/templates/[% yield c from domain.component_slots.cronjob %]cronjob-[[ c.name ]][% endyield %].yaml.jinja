[% set v = c.values_ref %]
[% set h = c.helper %]
{{- /*
===============================================================================
CronJob of the "[[ c.name ]]" component
===============================================================================
File generated by forge.

Runs [[ c.name ]] on a regular schedule: the controller creates a Job — and
therefore a fresh pod — on every firing of the schedule.

A CronJob is neither a Deployment nor a StatefulSet, and the following fields are
deliberately absent:
  * "replicas" and "selector": it is the Job created on each firing that carries
    its own selector, set by the controller. Writing them here would be refused;
  * the port of the container: with no Service, no traffic enters this pod;
  * the probes: a readinessProbe would have no consumer, and a failing
    livenessProbe would restart the container in the middle of a batch treatment.
    The health of a scheduled task is read from its exit code, which backoffLimit
    and the history of the Jobs are enough to exploit.

The nesting is spec.jobTemplate.spec.template.spec: two levels more than a
Deployment, that is four additional indentation spaces on the whole block of the
pod and of its container.

No value is hardcoded here. Everything comes from the "[[ c.name ]]" key of
values.yaml, overridable per environment.
===============================================================================
*/}}
{{- if [[ v ]].enabled }}
{{- $cron := [[ v ]].cron }}
{{- /*
  batch/v1beta1 has been removed since Kubernetes 1.25: batch/v1 is the only
  version served, it is therefore written with no condition on the cluster
  version.
*/}}
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
spec:
  {{- /*
    Five-field schedule. Quoted systematically: an expression starting with "*"
    would not be a valid YAML scalar.
  */}}
  schedule: {{ $cron.schedule | quote }}
  {{- /*
    timeZone is only emitted if it is filled in: the API refuses timeZone: "",
    whereas the absence of the key means "time zone of the controller".
  */}}
  {{- with $cron.timeZone }}
  timeZone: {{ . | quote }}
  {{- end }}
  {{- /*
    What to do if the previous run is still going at the next firing:
    Allow (start anyway), Forbid (skip), Replace (replace).
  */}}
  concurrencyPolicy: {{ $cron.concurrencyPolicy }}
  {{- /* Suspends the firings without deleting the object nor its history. */}}
  suspend: {{ $cron.suspend }}
  {{- /* Number of runs kept, successful then failed. */}}
  successfulJobsHistoryLimit: {{ $cron.successfulJobsHistoryLimit }}
  failedJobsHistoryLimit: {{ $cron.failedJobsHistoryLimit }}
  {{- /*
    startingDeadlineSeconds is null by default: the key then disappears from the
    manifest, which means "catch up with no limit on lateness". The test is on
    nullness, and not on the truthiness of the value, so that 0 stays
    transmissible.
  */}}
  {{- if not (kindIs "invalid" $cron.startingDeadlineSeconds) }}
  startingDeadlineSeconds: {{ $cron.startingDeadlineSeconds }}
  {{- end }}
  jobTemplate:
    metadata:
      {{- /*
        Labels of the Job created on each firing: they make it possible to find
        the runs of a component without knowing the suffix set by the controller.
        No selector is declared here, the controller sets its own.
      */}}
      labels:
        {{- include "[[ h ]].labels" . | nindent 8 }}
    spec:
      {{- /* Number of retries before giving up on the run of a firing. */}}
      backoffLimit: {{ $cron.backoffLimit }}
      template:
        metadata:
          labels:
            {{- include "[[ h ]].selectorLabels" . | nindent 12 }}
            {{- with [[ v ]].podLabels }}
            {{- toYaml . | nindent 12 }}
            {{- end }}
          {{- /*
            No checksum/config fingerprint is set, unlike on a Deployment: each
            firing creates a fresh pod, which necessarily reads the current
            configuration. There is therefore nothing to restart.
          */}}
          {{- with [[ v ]].podAnnotations }}
          annotations:
            {{- toYaml . | nindent 12 }}
          {{- end }}
        spec:
          {{- /*
            restartPolicy is mandatory in the pod of a Job and can only be
            OnFailure (restart the container in the same pod) or Never (let the Job
            create a new pod). "Always" passes the schema validation but is refused
            at apply time.

            The forge model only accepts those two values in forge.yml. A
            `--set <component>.cron.restartPolicy=Always` passed by hand at install
            time would, on the other hand, go through lint, template and
            kubeconform: it is the API of the cluster that would refuse, and it
            alone.
          */}}
          restartPolicy: {{ $cron.restartPolicy }}
[% if c.has.serviceaccount %]
          {{- /*
            Without this line, the pods would run under the "default" account of
            the namespace, whose rights are shared by everything deployed there.
          */}}
          serviceAccountName: {{ include "[[ h ]].serviceAccountName" . }}
[% endif %]
          {{- with .Values.global.imagePullSecrets }}
          imagePullSecrets:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{- with [[ v ]].podSecurityContext }}
          securityContext:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          containers:
            - name: [[ c.name ]]
              image: {{ include "[[ h ]].image" . }}
              imagePullPolicy: {{ [[ v ]].image.pullPolicy }}
              {{- with [[ v ]].securityContext }}
              securityContext:
                {{- toYaml . | nindent 16 }}
              {{- end }}
              {{- with [[ v ]].command }}
              command:
                {{- toYaml . | nindent 16 }}
              {{- end }}
              {{- with [[ v ]].args }}
              args:
                {{- toYaml . | nindent 16 }}
              {{- end }}
              env:
                - name: ENVIRONMENT
                  value: {{ .Values.global.environment | quote }}
                {{- with [[ v ]].extraEnv }}
                {{- toYaml . | nindent 16 }}
                {{- end }}
[% if c.has.configmap or c.has.secret %]
              {{- /*
                The sources injected as environment variables are accumulated in
                a list, then rendered in one block: an "envFrom:" key with no
                element would amount to null and would be refused.
                The mountAs key decides, source by source, between injection as
                variables (env) and mounting as files (file, further down).
              */}}
              {{- $envFrom := list }}
[% if c.has.configmap %]
              {{- if and [[ v ]].config.enabled (eq [[ v ]].config.mountAs "env") }}
              {{- $envFrom = append $envFrom (dict "configMapRef" (dict "name" (include "[[ h ]].configMapName" .))) }}
              {{- end }}
[% endif %]
[% if c.has.secret %]
              {{- if and [[ v ]].secret.enabled (eq [[ v ]].secret.mountAs "env") }}
              {{- $envFrom = append $envFrom (dict "secretRef" (dict "name" (include "[[ h ]].secretName" .))) }}
              {{- end }}
[% endif %]
              {{- with $envFrom }}
              envFrom:
                {{- toYaml . | nindent 16 }}
              {{- end }}
              {{- /* File mounts, for the sources whose mountAs is file. */}}
              {{- $volumeMounts := list }}
[% if c.has.configmap %]
              {{- if and [[ v ]].config.enabled (eq [[ v ]].config.mountAs "file") }}
              {{- $volumeMounts = append $volumeMounts (dict "name" "config" "mountPath" [[ v ]].config.mountPath "readOnly" true) }}
              {{- end }}
[% endif %]
[% if c.has.secret %]
              {{- if and [[ v ]].secret.enabled (eq [[ v ]].secret.mountAs "file") }}
              {{- $volumeMounts = append $volumeMounts (dict "name" "secret" "mountPath" [[ v ]].secret.mountPath "readOnly" true) }}
              {{- end }}
[% endif %]
              {{- with $volumeMounts }}
              volumeMounts:
                {{- toYaml . | nindent 16 }}
              {{- end }}
[% endif %]
              {{- with [[ v ]].resources }}
              resources:
                {{- toYaml . | nindent 16 }}
              {{- end }}
          {{- with [[ v ]].nodeSelector }}
          nodeSelector:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{- with [[ v ]].tolerations }}
          tolerations:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{- with [[ v ]].affinity }}
          affinity:
            {{- toYaml . | nindent 12 }}
          {{- end }}
[% if c.has.configmap or c.has.secret %]
          {{- /*
            Volumes corresponding to the file mounts declared above. The list
            stays empty as long as no source is in "file" mode, and the "volumes:"
            key then disappears entirely.
          */}}
          {{- $volumes := list }}
[% if c.has.configmap %]
          {{- if and [[ v ]].config.enabled (eq [[ v ]].config.mountAs "file") }}
          {{- $volumes = append $volumes (dict "name" "config" "configMap" (dict "name" (include "[[ h ]].configMapName" .))) }}
          {{- end }}
[% endif %]
[% if c.has.secret %]
          {{- if and [[ v ]].secret.enabled (eq [[ v ]].secret.mountAs "file") }}
          {{- $volumes = append $volumes (dict "name" "secret" "secret" (dict "secretName" (include "[[ h ]].secretName" .))) }}
          {{- end }}
[% endif %]
          {{- with $volumes }}
          volumes:
            {{- toYaml . | nindent 12 }}
          {{- end }}
[% endif %]
{{- end }}
