[% set v = c.values_ref %]
[% set h = c.helper %]
{{- /*
===============================================================================
HorizontalPodAutoscaler of the "[[ c.name ]]" component
===============================================================================
File generated by forge.

Adjusts the number of replicas of [[ c.name ]] between hpa.minReplicas and
hpa.maxReplicas, according to the average usage of the resources reserved by the
container. Driven by the environment profile: disabled in development, enabled in
production by values-<env>.yaml.

Traps this file guards against:
  * autoscaling/v2beta1 and v2beta2 have been removed since Kubernetes 1.26;
    only autoscaling/v2 remains;
  * the shape of the metrics of v2 is not that of v1: a
    "targetCPUUtilizationPercentage" set at the spec level would be an unknown
    field there, hence the "metrics" list below;
  * averageUtilization must be an integer — the string "80" is refused;
  * without resources.requests on the container, the corresponding metric stays
    unknown and the autoscaling does nothing, without any validator being able to
    report it: each metric is therefore only emitted if its reservation exists.
===============================================================================
*/}}
{{- if and [[ v ]].enabled [[ v ]].hpa.enabled }}
{{- /*
  The metrics are computed BEFORE the object: a HorizontalPodAutoscaler with no
  metric at all is accepted by the validators and by the API, but it will never
  act — a mute autoscaler is more misleading than no autoscaler at all. When no
  reservation is declared, the resource is therefore not generated, and the
  comment above says why.

  A metric whose corresponding reservation is absent is not emitted: it would be
  accepted by the validators and would nevertheless trigger nothing.
*/}}
{{- $metrics := list }}
{{- if [[ v ]].resources.requests.cpu }}
{{- $metrics = append $metrics (dict "type" "Resource" "resource" (dict "name" "cpu" "target" (dict "type" "Utilization" "averageUtilization" (int [[ v ]].hpa.targetCPUUtilizationPercentage)))) }}
{{- end }}
{{- if and [[ v ]].hpa.targetMemoryUtilizationPercentage [[ v ]].resources.requests.memory }}
{{- $metrics = append $metrics (dict "type" "Resource" "resource" (dict "name" "memory" "target" (dict "type" "Utilization" "averageUtilization" (int [[ v ]].hpa.targetMemoryUtilizationPercentage)))) }}
{{- end }}
{{- if $metrics }}
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
spec:
  {{- /*
    The target is the workload of the component, designated by its fullname: the
    fullname of the chart would designate another resource — or even none — and
    the autoscaler would remain without visible effect.
  */}}
  scaleTargetRef:
    apiVersion: apps/v1
    kind: [[ "StatefulSet" if c.kind == "statefulset" else "Deployment" ]]
    name: {{ include "[[ h ]].fullname" . }}
  {{- /* The bounds are forced to integer: a string would be refused. */}}
  minReplicas: {{ [[ v ]].hpa.minReplicas | int }}
  maxReplicas: {{ [[ v ]].hpa.maxReplicas | int }}
  {{- /* A "metrics:" key with no element would amount to null and be refused. */}}
  metrics:
    {{- toYaml $metrics | nindent 4 }}
{{- end }}
{{- end }}
