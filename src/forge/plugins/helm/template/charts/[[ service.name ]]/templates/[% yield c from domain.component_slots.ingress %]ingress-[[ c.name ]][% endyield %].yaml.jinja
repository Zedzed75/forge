[% set v = c.values_ref %]
[% set h = c.helper %]
{{- /*
===============================================================================
Ingress of the "[[ c.name ]]" component
===============================================================================
File generated by forge.

Publishes [[ c.name ]] outside the cluster: the Ingress controller receives the
HTTP(S) traffic for a host, then relays it to the Service of the component.

The host is NOT computed here. It is set by values-<environment>.yaml, which
derives it from the domain of the environment; this template only reads it. As
long as it stays empty, the whole object is omitted: a rule with no host would
write a "host: null" that the schema refuses, and an Ingress without a single rule
would route nothing.

The backend designates the Service by the NAME of its port, never by a number:
changing the port in the values is then enough, without having to carry it over
here. That Service always exists: the specification refuses the ingress addon
without the service addon. There remains the case where it is disabled at runtime,
tested below.
===============================================================================
*/}}
{{- if and [[ v ]].enabled [[ v ]].service.enabled [[ v ]].ingress.enabled [[ v ]].ingress.host }}
{{- /*
  Local shortcuts. $host is read once then reused everywhere: the rule and the
  tls[].hosts list must carry literally the same host, otherwise the certificate
  does not cover the host being served. No validator sees that discrepancy — it
  only shows up at runtime, as a certificate error.
*/}}
{{- $ingress := [[ v ]].ingress }}
{{- $host := $ingress.host }}
{{- /*
  The annotations are copied into a local dict before being completed: writing
  into .Values would contaminate every template rendered afterwards.
*/}}
{{- $annotations := merge (dict) (default (dict) $ingress.annotations) }}
{{- /*
  cert-manager annotation deduced from tls.issuer, and only if the user has not
  already set their own: it is the one that triggers the issuance of the
  certificate referenced further down by secretName.
*/}}
{{- if and $ingress.tls.enabled $ingress.tls.issuer (not (hasKey $annotations "cert-manager.io/cluster-issuer")) }}
{{- $_ := set $annotations "cert-manager.io/cluster-issuer" $ingress.tls.issuer }}
{{- end }}
{{- /*
  ingressClassName and the obsolete kubernetes.io/ingress.class annotation must
  never coexist: controllers draw contradictory conclusions from them. The modern
  field wins, the annotation is removed.
*/}}
{{- if $ingress.className }}
{{- $annotations = omit $annotations "kubernetes.io/ingress.class" }}
{{- end }}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
  {{- with $annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  {{- if $ingress.className }}
  {{- /* Controller in charge of serving this rule (nginx, traefik...). */}}
  ingressClassName: {{ $ingress.className | quote }}
  {{- end }}
  {{- if $ingress.tls.enabled }}
  {{- /*
    tls block entirely absent when TLS termination is disabled: a "tls: []" would
    be refused. An empty secretName falls back on <resource>-tls.
  */}}
  tls:
    - hosts:
        - {{ $host | quote }}
      secretName: {{ default (printf "%s-tls" (include "[[ h ]].fullname" .)) $ingress.tls.secretName | quote }}
  {{- end }}
  rules:
    - host: {{ $host | quote }}
      http:
        paths:
          {{- /*
            pathType is mandatory on every path. Forgetting it is the most
            frequent rejection of a strict schema validation.
          */}}
          - path: {{ $ingress.path | quote }}
            pathType: {{ $ingress.pathType | quote }}
            backend:
              service:
                name: {{ include "[[ h ]].fullname" . }}
                {{- /*
                  "port" accepts exactly one of the two forms, number OR name —
                  never both. This chart sticks to the name.
                */}}
                port:
                  name: {{ [[ v ]].portName | quote }}
{{- end }}
