[% set v = c.values_ref %]
[% set h = c.helper %]
{{- /*
===============================================================================
NetworkPolicy du composant « [[ c.name ]] »
===============================================================================
Fichier généré par forge.

Cloisonne le trafic réseau des pods de [[ c.name ]] : fermé par défaut, ouvert
explicitement, source par source.

C'est la ressource où une erreur ne se voit pas. Deux confusions suffisent à
tout inverser, et chaque garde de ce fichier est là pour l'une d'elles :

  * une règle vide « - {} » autorise TOUT, là où l'absence de règle interdit
    tout. Les deux se ressemblent, et aucun validateur ne les distingue ;
  * annoncer « Egress » dans policyTypes sans écrire la moindre règle de sortie
    coupe tout le trafic sortant, résolution de noms comprise : le composant ne
    joint plus rien, sans le moindre message d'erreur.

Aucune valeur n'est écrite en dur : tout vient de la clé
« [[ c.name ]].networkPolicy » de values.yaml, surchargeable par environnement.
===============================================================================
*/}}
{{- if and [[ v ]].enabled [[ v ]].networkPolicy.enabled }}
{{- /*
  Les listes de règles sont décidées AVANT d'écrire policyTypes : c'est la
  seule façon de n'annoncer un type de trafic que si une règle le concernant
  suit réellement.
*/ -}}
{{- $np := [[ v ]].networkPolicy -}}
{{- $fromNamespaces := $np.allowFromNamespaces | default list -}}
{{- $hasIngressRule := or $np.allowFromSameNamespace (gt (len $fromNamespaces) 0) -}}
{{- $hasEgressRule := or $np.allowEgressAll $np.allowDNS -}}
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
spec:
  {{- /*
    podSelector est obligatoire, même vide — mais un podSelector vide viserait
    TOUS les pods du namespace, donc aussi les autres composants du chart et
    tout ce qui se déploie à côté. On y met les labels de sélection de
    [[ c.name ]], et eux seuls : la politique ne régit que ses propres pods.
    Ces labels viennent du helper, jamais recopiés : ils doivent rester
    identiques à ceux que la charge de travail pose sur ses pods.
  */}}
  podSelector:
    matchLabels:
      {{- include "[[ h ]].selectorLabels" . | nindent 6 }}
  {{- /*
    policyTypes est explicite : un type absent de cette liste n'est pas régi
    par cette politique et reste donc libre.
    « Ingress » y figure toujours — restreindre l'entrée est l'objet même de
    cette ressource. « Egress » n'y figure que si une règle de sortie suit :
    l'annoncer sans règle couperait tout le sortant, DNS compris.
    Pour cloisonner aussi la sortie, laisser allowDNS à true et allowEgressAll
    à false : la sortie se réduit alors à la seule résolution de noms.
  */}}
  policyTypes:
    - Ingress
    {{- if $hasEgressRule }}
    - Egress
    {{- end }}
  {{- if $hasIngressRule }}
  {{- /*
    Un seul élément de règle entrante. À l'intérieur, « from » et « ports » se
    combinent en ET : la source doit être autorisée ET viser le bon port.
  */}}
  ingress:
    - from:
        {{- if $np.allowFromSameNamespace }}
        {{- /*
          Un podSelector vide désigne tous les pods ; seul dans son élément,
          sans namespaceSelector à côté, il reste borné au namespace de la
          politique. C'est bien « tout le namespace », pas « tout le cluster ».
        */}}
        - podSelector: {}
        {{- end }}
        {{- range $fromNamespaces }}
        {{- /*
          Chaque namespace autorisé est un élément distinct de la liste : deux
          sélecteurs placés dans le MÊME élément seraient un ET (ce namespace
          ET ces pods-là), dans deux éléments un OU. La différence tient à un
          tiret, et elle est silencieuse.
          Le label kubernetes.io/metadata.name est posé automatiquement par
          Kubernetes sur chaque namespace : il n'y a rien à étiqueter à la main.
        */}}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ . | quote }}
        {{- end }}
      {{- /*
        Le port cité est celui du CONTENEUR, jamais celui du Service : la
        politique s'applique aux pods, le Service n'est qu'un intermédiaire et
        son port n'a aucun sens ici.
[% if c.has.service %]
        Le Service de [[ c.name ]] écoute sur sa propre clé « service.port » et
        redirige vers containerPort : c'est ce dernier qu'il faut nommer ici,
        même quand les deux ports diffèrent.
[% endif %]
        Tout autre port du conteneur reste fermé : c'est voulu.
      */}}
      ports:
        - protocol: TCP
          port: {{ [[ v ]].containerPort }}
  {{- else }}
  {{- /*
    Aucune source autorisée. La liste est écrite vide, explicitement : une
    liste de règles vide interdit tout le trafic entrant. C'est le résultat
    voulu, et l'écrire noir sur blanc évite d'y lire un oubli.
  */}}
  ingress: []
  {{- end }}
[% if c.has.ingress %]
  {{- /*
    Rappel : [[ c.name ]] est exposé par un Ingress, et le trafic n'arrive pas
    du client mais des pods du contrôleur d'Ingress, qui vivent le plus souvent
    dans un autre namespace. Tant que ce namespace ne figure pas dans
    allowFromNamespaces, l'Ingress répondra 502 : la politique aura fait
    exactement ce qu'on lui a demandé.
  */}}
[% endif %]
  {{- if $hasEgressRule }}
  egress:
    {{- if $np.allowEgressAll }}
    {{- /*
      Règle volontairement vide. Sans « to » ni « ports », elle autorise TOUTE
      destination sur TOUT port, résolution de noms comprise — l'exact inverse
      de l'absence de règle, qui interdit tout. Rien dans la syntaxe ne le dit :
      c'est la raison d'être de ce commentaire.
    */}}
    - {}
    {{- else if $np.allowDNS }}
    {{- /*
      Sortie réduite à la résolution de noms, seul trafic sans lequel le
      composant ne joint plus rien — pas même par son nom de Service.
      La règle ne porte délibérément pas de « to » : seuls les ports sont
      contraints, la destination reste libre. Le résolveur peut être un CoreDNS
      du namespace kube-system comme un cache local au nœud, joint sur l'adresse
      du nœud, qu'aucun namespaceSelector ne saurait désigner.
      Les deux protocoles sont nécessaires : UDP pour le cas courant, TCP pour
      les réponses trop grandes pour un datagramme.
    */}}
    - ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    {{- end }}
  {{- end }}
{{- end }}
