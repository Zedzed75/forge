[% set v = c.values_ref %]
[% set h = c.helper %]
{{- /*
===============================================================================
PodDisruptionBudget of the "[[ c.name ]]" component
===============================================================================
File generated by forge.

Guarantees that a minimum of [[ c.name ]] pods stays available during voluntary
disruptions: node drain, cluster upgrade, rebalancing by the scheduler. Driven
by the environment profile: disabled in development, enabled in production by
values-<env>.yaml.

Traps this file guards against:
  * policy/v1beta1 has been removed since Kubernetes 1.25; only policy/v1
    remains;
  * minAvailable and maxUnavailable are mutually exclusive, and kubeconform does
    not model that exclusion: the guard is below, never both keys at once;
  * the selector targets the component alone — a selector at the chart level
    would block the evictions of all the other components;
  * minAvailable: 1 with a single replica makes any drain impossible: that is the
    reason why the development profile leaves pdb.enabled at false.
===============================================================================
*/}}
{{- if and [[ v ]].enabled [[ v ]].pdb.enabled }}
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
spec:
  {{- /*
    Mutual exclusion: the API rejects a budget that carries both bounds, and no
    schema detects it before the apply. The chart only exposes minAvailable; if
    maxUnavailable has been added to the values all the same, it is the one that
    is kept, and minAvailable disappears.
    Both keys accept an integer or a percentage between quotes: toYaml preserves
    the original type rather than flattening everything into a string.
  */}}
  {{- if [[ v ]].pdb.maxUnavailable }}
  maxUnavailable: {{ [[ v ]].pdb.maxUnavailable | toYaml }}
  {{- else }}
  minAvailable: {{ [[ v ]].pdb.minAvailable | toYaml }}
  {{- end }}
  {{- /*
    Selector restricted to the component: the selectorLabels of the component
    carry app.kubernetes.io/component in addition to those of the chart. The full
    labels would be to be avoided — they contain helm.sh/chart and
    app.kubernetes.io/version, which change on every release.
  */}}
  selector:
    matchLabels:
      {{- include "[[ h ]].selectorLabels" . | nindent 6 }}
{{- end }}
