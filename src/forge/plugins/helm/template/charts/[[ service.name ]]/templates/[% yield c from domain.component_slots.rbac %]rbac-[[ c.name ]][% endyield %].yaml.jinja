[% set v = c.values_ref %]
[% set h = c.helper %]
{{- /*
===============================================================================
Role and RoleBinding of the "[[ c.name ]]" component
===============================================================================
File generated by forge.

Grants the ServiceAccount of [[ c.name ]] minimal rights, and only in the
namespace of the release. The Role enumerates the permissions, the RoleBinding
attaches them to the account: the two go together and therefore live in the same
file, separated by "---".

Scope: namespace, exclusively. This chart produces neither ClusterRole nor
ClusterRoleBinding — cluster-scoped rights go beyond what a release should be able
to grant itself.

Three points to watch:
  * a Role with no rule is valid as far as the schema is concerned, but useless
    and misleading: as long as rbac.rules is empty, neither Role nor RoleBinding
    is produced;
  * roleRef is immutable once the RoleBinding is created. The targeted Role is
    therefore named by the naming helper of the component, never by a free value:
    a name that changed would make the next "helm upgrade" fail;
  * in the rules, apiGroups must contain the empty string ("") for the resources
    of the core group — pods, configmaps, secrets, services. An apiGroups omitted
    or named "core" grants nothing, without the slightest error.

No value is hardcoded here. Everything comes from the "[[ c.name ]].rbac" key of
values.yaml, overridable per environment.
===============================================================================
*/}}
{{- if and [[ v ]].enabled [[ v ]].rbac.create [[ v ]].rbac.rules }}
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
{{- /*
  The rules are taken as they are from the values: it is up to the operator to
  keep them as tight as possible, one rule per real need.
*/}}
rules:
  {{- toYaml [[ v ]].rbac.rules | nindent 2 }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
{{- /*
  The targeted Role is the one defined just above, designated by the same helper.
  This field is immutable: modifying it requires deleting the RoleBinding.
*/}}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ include "[[ h ]].fullname" . }}
{{- /*
  A subject of type ServiceAccount requires an explicit namespace: without it, the
  API attaches the right to nobody and the component stays without permission.
  The name comes from the dedicated helper, the very one the workload uses — a
  copied name would end up designating an account that does not exist.
*/}}
subjects:
  - kind: ServiceAccount
    name: {{ include "[[ h ]].serviceAccountName" . }}
    namespace: {{ .Release.Namespace }}
{{- end }}
