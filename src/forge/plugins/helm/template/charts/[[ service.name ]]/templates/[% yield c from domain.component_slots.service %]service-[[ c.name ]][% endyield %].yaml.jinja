[% set v = c.values_ref %]
[% set h = c.helper %]
{{- /*
===============================================================================
Service of the "[[ c.name ]]" component
===============================================================================
File generated by forge.

Exposes the pods of [[ c.name ]] behind a stable DNS name and a virtual address.
The Service selects its pods by the selection labels of the component, never by
their name.
===============================================================================
*/}}
{{- if and [[ v ]].enabled [[ v ]].service.enabled }}
apiVersion: v1
kind: Service
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
  {{- with [[ v ]].service.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
[% if c.service.headless %]
  {{- /*
    Headless Service: with no virtual address, DNS returns the addresses of the
    pods directly. That is what gives each pod of a StatefulSet an individual
    and stable DNS name.
  */}}
  clusterIP: None
[% else %]
  type: {{ [[ v ]].service.type }}
[% endif %]
  ports:
    - name: {{ [[ v ]].portName }}
      port: {{ [[ v ]].service.port }}
      {{- /* targetPort designates the port of the container, here by its name. */}}
      targetPort: {{ [[ v ]].portName }}
      protocol: TCP
  selector:
    {{- include "[[ h ]].selectorLabels" . | nindent 4 }}
{{- end }}
