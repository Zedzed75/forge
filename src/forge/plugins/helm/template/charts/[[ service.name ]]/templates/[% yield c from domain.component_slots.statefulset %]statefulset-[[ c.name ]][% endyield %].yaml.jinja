[% set v = c.values_ref %]
[% set h = c.helper %]
{{- /*
===============================================================================
StatefulSet of the "[[ c.name ]]" component
===============================================================================
File generated by forge.

Deploys [[ c.name ]] as a stateful workload: each pod keeps its ordinal, its DNS
name and its volume from one restart to the next. That is what distinguishes it
from a Deployment, whose pods are interchangeable.

Three fields are specific to it, and all three are known traps:
  * serviceName            the headless Service that names each pod;
  * volumeClaimTemplates   the per-pod volume — entirely IMMUTABLE;
  * updateStrategy and podManagementPolicy   the replacement order of the pods.

No value is hardcoded here. Everything comes from the "[[ c.name ]]" key of
values.yaml, overridable per environment.
===============================================================================
*/}}
{{- if [[ v ]].enabled }}
{{- /*
  Name of the persistent volume, defined once and reused in the two places that
  absolutely must agree: the volumeMount of the container and the
  volumeClaimTemplate. A discrepancy between the two would produce a manifest
  valid against the schema, but pods stuck at startup.
*/}}
{{- $dataVolume := "data" }}
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ include "[[ h ]].fullname" . }}
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
spec:
[% if c.has.service %]
  {{- /*
    serviceName is required, and the targeted Service must really be headless
    (clusterIP: None). forge forces service.headless for a StatefulSet, and the
    Service carries the same naming helper as this workload: the two therefore
    cannot diverge.
    Setting service.enabled back to false would leave this name with no Service
    behind it, and the pods with no individual DNS entry.
  */}}
  serviceName: {{ include "[[ h ]].fullname" . }}
[% else %]
  {{- /*
    serviceName is a required field: it is rendered so that the manifest stays
    valid. WARNING: the "[[ c.name ]]" component does not have the "service"
    addon, no headless Service is therefore generated and the pods will not have
    a stable DNS name. Add the "service" addon to the specification.
  */}}
  serviceName: {{ include "[[ h ]].fullname" . }}
[% endif %]
[% if c.has.hpa %]
  {{- /*
    When autoscaling is active, "replicas" is deliberately not rendered: Helm
    would reset it to replicaCount on every update, the HorizontalPodAutoscaler
    would recompute it straight away, and the two would fight on every
    "helm upgrade".
  */}}
  {{- if not [[ v ]].hpa.enabled }}
  replicas: {{ [[ v ]].replicaCount }}
  {{- end }}
[% else %]
  replicas: {{ [[ v ]].replicaCount }}
[% endif %]
  {{- /*
    podManagementPolicy sets the start and stop order of the pods:
      OrderedReady : one pod at a time, from the smallest ordinal to the largest,
                     waiting for the previous one to be ready — behaviour applied
                     by Kubernetes when the key is absent;
      Parallel : all the pods at the same time, for a set whose members discover
                 each other on their own.
    The key is immutable after creation. It is only rendered if the values fill it
    in: omitting it lets Kubernetes apply OrderedReady, whereas a hardcoded value
    would freeze the choice for every environment.
  */}}
  {{- with [[ v ]].podManagementPolicy }}
  podManagementPolicy: {{ . }}
  {{- end }}
  {{- /*
    Replacement strategy of the pods during an update:
      RollingUpdate : the pods are replaced one by one, from the highest ordinal
                      to the lowest;
      OnDelete : nothing is replaced automatically; deleting a pod triggers its
                 recreation at the new version.
    The rollingUpdate sub-block only makes sense with RollingUpdate: emitting it
    with OnDelete makes the API reject the object.
  */}}
  updateStrategy:
    type: {{ [[ v ]].updateStrategy.type }}
    {{- if eq [[ v ]].updateStrategy.type "RollingUpdate" }}
    rollingUpdate:
      {{- /* The pods with an ordinal below partition stay at the old version. */}}
      partition: {{ [[ v ]].updateStrategy.partition | int }}
    {{- end }}
  {{- /*
    The selector is required AND immutable: it only uses selectorLabels, which
    contains neither helm.sh/chart nor app.kubernetes.io/version — two labels that
    change on every release and would make the object unmodifiable.
  */}}
  selector:
    matchLabels:
      {{- include "[[ h ]].selectorLabels" . | nindent 6 }}
  template:
    metadata:
      labels:
        {{- include "[[ h ]].selectorLabels" . | nindent 8 }}
        {{- with [[ v ]].podLabels }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
[% if c.has.configmap and c.config["keys"] %]
      {{- /*
        The fingerprint of the ConfigMap restarts the pods as soon as the
        configuration changes: without it, a "helm upgrade" that only touches the
        ConfigMap would leave the pods on the old configuration, without any sign.
        The path quoted is exactly that of the template file produced — any
        divergence would make the rendering fail on a template that cannot be
        found.
      */}}
      annotations:
        checksum/config: {{ include (print $.Template.BasePath "/configmap-[[ c.name ]].yaml") . | sha256sum }}
        {{- with [[ v ]].podAnnotations }}
        {{- toYaml . | nindent 8 }}
        {{- end }}
[% else %]
      {{- with [[ v ]].podAnnotations }}
      annotations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
[% endif %]
    spec:
[% if c.has.serviceaccount %]
      {{- /*
        Without this line, the pods would run under the "default" account of the
        namespace, whose rights are shared by everything deployed there.
      */}}
      serviceAccountName: {{ include "[[ h ]].serviceAccountName" . }}
[% endif %]
      {{- with .Values.global.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- /*
        fsGroup, carried by podSecurityContext, sets the owning group of the
        persistent volume: without it, a non-root container cannot write to it, and
        the application starts then fails on the first write.
      */}}
      {{- with [[ v ]].podSecurityContext }}
      securityContext:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      containers:
        - name: [[ c.name ]]
          image: {{ include "[[ h ]].image" . }}
          imagePullPolicy: {{ [[ v ]].image.pullPolicy }}
          {{- with [[ v ]].securityContext }}
          securityContext:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{- with [[ v ]].command }}
          command:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{- with [[ v ]].args }}
          args:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          ports:
            - name: {{ [[ v ]].portName }}
              containerPort: {{ [[ v ]].containerPort }}
              protocol: TCP
          {{- if [[ v ]].probes.enabled }}
          {{- /* A failing liveness probe makes the container restart. */}}
          livenessProbe:
            httpGet:
              path: {{ [[ v ]].probes.liveness.path }}
              port: {{ [[ v ]].portName }}
            initialDelaySeconds: {{ [[ v ]].probes.liveness.initialDelaySeconds }}
            periodSeconds: {{ [[ v ]].probes.liveness.periodSeconds }}
            timeoutSeconds: {{ [[ v ]].probes.liveness.timeoutSeconds }}
            failureThreshold: {{ [[ v ]].probes.liveness.failureThreshold }}
          {{- /* A failing readiness probe removes the pod from the Service, without killing it. */}}
          readinessProbe:
            httpGet:
              path: {{ [[ v ]].probes.readiness.path }}
              port: {{ [[ v ]].portName }}
            initialDelaySeconds: {{ [[ v ]].probes.readiness.initialDelaySeconds }}
            periodSeconds: {{ [[ v ]].probes.readiness.periodSeconds }}
            timeoutSeconds: {{ [[ v ]].probes.readiness.timeoutSeconds }}
            failureThreshold: {{ [[ v ]].probes.readiness.failureThreshold }}
          {{- if [[ v ]].probes.startup.enabled }}
          {{- /*
            The startup probe suspends liveness and readiness as long as it has
            not succeeded: that is what prevents a stateful application, slow to
            replay its journal, from being killed in a loop by the liveness probe.
          */}}
          startupProbe:
            httpGet:
              path: {{ [[ v ]].probes.startup.path }}
              port: {{ [[ v ]].portName }}
            periodSeconds: {{ [[ v ]].probes.startup.periodSeconds }}
            failureThreshold: {{ [[ v ]].probes.startup.failureThreshold }}
          {{- end }}
          {{- end }}
          env:
            - name: ENVIRONMENT
              value: {{ .Values.global.environment | quote }}
            {{- with [[ v ]].extraEnv }}
            {{- toYaml . | nindent 12 }}
            {{- end }}
[% if c.has.configmap or c.has.secret %]
          {{- /*
            The sources injected as environment variables are accumulated in a
            list, then rendered in one block: an "envFrom:" key with no element
            would amount to null and would be refused.
            The mountAs key decides, source by source, between injection as
            variables (env) and mounting as files (file, further down).
          */}}
          {{- $envFrom := list }}
[% if c.has.configmap %]
          {{- if and [[ v ]].config.enabled (eq [[ v ]].config.mountAs "env") }}
          {{- $envFrom = append $envFrom (dict "configMapRef" (dict "name" (include "[[ h ]].configMapName" .))) }}
          {{- end }}
[% endif %]
[% if c.has.secret %]
          {{- if and [[ v ]].secret.enabled (eq [[ v ]].secret.mountAs "env") }}
          {{- $envFrom = append $envFrom (dict "secretRef" (dict "name" (include "[[ h ]].secretName" .))) }}
          {{- end }}
[% endif %]
          {{- with $envFrom }}
          envFrom:
            {{- toYaml . | nindent 12 }}
          {{- end }}
[% endif %]
          {{- /*
            Mounts of the container: the persistent volume first — its name comes
            from the same variable as the volumeClaimTemplate, so they cannot
            diverge — then the sources whose mountAs is "file".
            The list is rendered in one block: a "volumeMounts:" key with no element
            would amount to null and would be refused.
          */}}
          {{- $volumeMounts := list }}
          {{- if [[ v ]].persistence.enabled }}
          {{- $volumeMounts = append $volumeMounts (dict "name" $dataVolume "mountPath" [[ v ]].persistence.mountPath) }}
          {{- end }}
[% if c.has.configmap %]
          {{- if and [[ v ]].config.enabled (eq [[ v ]].config.mountAs "file") }}
          {{- $volumeMounts = append $volumeMounts (dict "name" "config" "mountPath" [[ v ]].config.mountPath "readOnly" true) }}
          {{- end }}
[% endif %]
[% if c.has.secret %]
          {{- if and [[ v ]].secret.enabled (eq [[ v ]].secret.mountAs "file") }}
          {{- $volumeMounts = append $volumeMounts (dict "name" "secret" "mountPath" [[ v ]].secret.mountPath "readOnly" true) }}
          {{- end }}
[% endif %]
          {{- with $volumeMounts }}
          volumeMounts:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{- with [[ v ]].resources }}
          resources:
            {{- toYaml . | nindent 12 }}
          {{- end }}
      {{- with [[ v ]].nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with [[ v ]].tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with [[ v ]].affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}
[% if c.has.configmap or c.has.secret %]
      {{- /*
        Volumes corresponding to the file mounts declared above. The persistent
        volume does not appear there: it comes from volumeClaimTemplates, which
        creates one instance of it per pod. The list stays empty as long as no
        source is in "file" mode, and the "volumes:" key then disappears.
      */}}
      {{- $volumes := list }}
[% if c.has.configmap %]
      {{- if and [[ v ]].config.enabled (eq [[ v ]].config.mountAs "file") }}
      {{- $volumes = append $volumes (dict "name" "config" "configMap" (dict "name" (include "[[ h ]].configMapName" .))) }}
      {{- end }}
[% endif %]
[% if c.has.secret %]
      {{- if and [[ v ]].secret.enabled (eq [[ v ]].secret.mountAs "file") }}
      {{- $volumes = append $volumes (dict "name" "secret" "secret" (dict "secretName" (include "[[ h ]].secretName" .))) }}
      {{- end }}
[% endif %]
      {{- with $volumes }}
      volumes:
        {{- toYaml . | nindent 8 }}
      {{- end }}
[% endif %]
  {{- if [[ v ]].persistence.enabled }}
  {{- /*
    A volumeClaimTemplate creates one PersistentVolumeClaim per pod, named
    <volume name>-<pod name>, and keeps it even if the pod disappears.

    This block is ENTIRELY IMMUTABLE: changing the size, the storage class or the
    access mode makes "helm upgrade" fail. To adjust it, delete the StatefulSet
    without its pods (kubectl delete statefulset <name> --cascade=orphan) then
    reinstall; the volumes already provisioned are kept.
    That is also the reason why only the selectorLabels are set here, and never the
    full labels: the latter carry helm.sh/chart and app.kubernetes.io/version, which
    change on every release and would make any "helm upgrade" impossible.
  */}}
  volumeClaimTemplates:
    - metadata:
        {{- /* This name must be exactly that of the volumeMount above. */}}
        name: {{ $dataVolume }}
        labels:
          {{- include "[[ h ]].selectorLabels" . | nindent 10 }}
      spec:
        accessModes:
          - {{ [[ v ]].persistence.accessMode }}
        {{- /*
          storageClassName absent = default class of the cluster;
          storageClassName: "" = NO class, and therefore no dynamic provisioning.
          The key is therefore only emitted if it is non-empty.
        */}}
        {{- with [[ v ]].persistence.storageClass }}
        storageClassName: {{ . | quote }}
        {{- end }}
        resources:
          requests:
            storage: {{ [[ v ]].persistence.size | quote }}
  {{- end }}
{{- end }}
