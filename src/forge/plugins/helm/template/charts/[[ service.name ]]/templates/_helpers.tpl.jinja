{{/*
===============================================================================
_helpers.tpl — naming and labelling functions of the "[[ service.name ]]" chart
===============================================================================
File generated by forge.

No resource name and no label is hardcoded in the templates: everything goes
through the helpers defined here. A single change is therefore enough to rename
or relabel the whole chart.

Naming convention of the helpers:
  [[ service.name ]].<name>             helper global to the chart
  [[ service.name ]].<component>.<name> helper specific to a component
===============================================================================
*/}}

{{/*
Name of the chart, possibly replaced by nameOverride.
Truncated to 63 characters: that is the limit of a DNS-1123 label, and a longer
name would be refused by the Kubernetes API.
*/}}
{{- define "[[ service.name ]].name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Full name of the resources: <release>-<chart>.
When the release name already contains the chart name, it is used on its own so
as to avoid duplicates of the "shop-shop" kind.
*/}}
{{- define "[[ service.name ]].fullname" -}}
{{- if .Values.fullnameOverride }}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- $name := default .Chart.Name .Values.nameOverride }}
{{- if contains $name .Release.Name }}
{{- .Release.Name | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}
{{- end }}

{{/*
Identifier of the chart, in the <name>-<version> format, set on the
helm.sh/chart label. The "+" of a possible SemVer build is replaced: it is not
allowed in a label value.
*/}}
{{- define "[[ service.name ]].chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Selection labels: stable and immutable subset of the labels.
They serve as the selector of the Deployments and of the Services; never add a
changing value such as the version to them, on pain of making the Deployment
unmodifiable (the selector field is immutable after creation).
*/}}
{{- define "[[ service.name ]].selectorLabels" -}}
app.kubernetes.io/name: {{ include "[[ service.name ]].name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

{{/*
Standard labels recommended by Kubernetes, set on every resource.
*/}}
{{- define "[[ service.name ]].labels" -}}
helm.sh/chart: {{ include "[[ service.name ]].chart" . }}
{{ include "[[ service.name ]].selectorLabels" . }}
{{- if .Chart.AppVersion }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
{{- end }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- if .Values.global.environment }}
environment: {{ .Values.global.environment | quote }}
{{- end }}
{{- end }}

[% for component in domain.components %]
{{/*
-------------------------------------------------------------------------------
Component "[[ component.name ]]"
-------------------------------------------------------------------------------
*/}}

{{/*
Full name of the resources of the component: <release>-<chart>-[[ component.name ]].
*/}}
{{- define "[[ component.helper ]].fullname" -}}
{{- printf "%s-%s" (include "[[ service.name ]].fullname" .) "[[ component.name ]]" | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/*
Selection labels of the component: those of the chart, plus the component label.
*/}}
{{- define "[[ component.helper ]].selectorLabels" -}}
{{ include "[[ service.name ]].selectorLabels" . }}
app.kubernetes.io/component: [[ component.name ]]
{{- end }}

{{/*
Full labels of the component.
*/}}
{{- define "[[ component.helper ]].labels" -}}
{{ include "[[ service.name ]].labels" . }}
app.kubernetes.io/component: [[ component.name ]]
{{- end }}

{{/*
Full reference of the image: <registry>/<repository>:<tag>.
A tag left empty in the values falls back on the appVersion of Chart.yaml, which
avoids having to fill it in two places on every release.
*/}}
{{- define "[[ component.helper ]].image" -}}
{{- $values := [[ component.values_ref ]] -}}
{{- $tag := $values.image.tag | default .Chart.AppVersion -}}
{{- if .Values.global.imageRegistry -}}
{{- printf "%s/%s:%s" .Values.global.imageRegistry $values.image.repository $tag -}}
{{- else -}}
{{- printf "%s:%s" $values.image.repository $tag -}}
{{- end -}}
{{- end }}
[% if component.has.serviceaccount %]

{{/*
Name of the ServiceAccount the pods of the component run under.
When the chart creates the account, its name is that of the component; otherwise
it is that of a pre-existing account, and "default" failing that — in which case
the pods inherit the rights shared by the whole namespace.
The workload MUST set serviceAccountName with this helper: without it, the
dedicated account is created but nobody uses it.
*/}}
{{- define "[[ component.helper ]].serviceAccountName" -}}
{{- $values := [[ component.values_ref ]] -}}
{{- if $values.serviceAccount.create -}}
{{- default (include "[[ component.helper ]].fullname" .) $values.serviceAccount.name -}}
{{- else -}}
{{- default "default" $values.serviceAccount.name -}}
{{- end -}}
{{- end }}
[% endif %]
[% if component.has.configmap %]

{{/*
Name of the ConfigMap of the component. Every resource that references it goes
through this helper: a name copied by hand would end up diverging.
*/}}
{{- define "[[ component.helper ]].configMapName" -}}
{{- printf "%s-config" (include "[[ component.helper ]].fullname" .) | trunc 63 | trimSuffix "-" -}}
{{- end }}
[% endif %]
[% if component.has.secret %]

{{/*
Name of the Secret of the component: the one the chart creates, or that of a
Secret managed outside the chart when secret.create is false.
*/}}
{{- define "[[ component.helper ]].secretName" -}}
{{- $values := [[ component.values_ref ]] -}}
{{- if and (not $values.secret.create) $values.secret.existingSecret -}}
{{- $values.secret.existingSecret -}}
{{- else -}}
{{- printf "%s-secret" (include "[[ component.helper ]].fullname" .) | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end }}
[% endif %]
[% endfor %]
