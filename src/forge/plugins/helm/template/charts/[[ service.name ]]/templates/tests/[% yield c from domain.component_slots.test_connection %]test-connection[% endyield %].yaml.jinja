[% set v = c.values_ref %]
[% set h = c.helper %]
{{/*
===============================================================================
Connection test of the "[[ c.name ]]" component
===============================================================================
File generated by forge.

This pod is only created by "helm test <release>", thanks to the
helm.sh/hook: test annotation. It queries the Service of [[ c.name ]] and fails
if that one does not answer, which makes it possible to validate a release before
declaring it good.

The hook-delete-policy annotation deletes the pod as soon as it has succeeded,
while keeping it on failure to allow its logs to be read.
===============================================================================
*/}}
{{- if and .Values.tests.enabled [[ v ]].enabled [[ v ]].service.enabled }}
apiVersion: v1
kind: Pod
metadata:
  name: {{ include "[[ h ]].fullname" . }}-test-connection
  labels:
    {{- include "[[ h ]].labels" . | nindent 4 }}
  annotations:
    helm.sh/hook: test
    helm.sh/hook-delete-policy: hook-succeeded
spec:
  restartPolicy: Never
  containers:
    - name: connection-test
      image: "{{ .Values.tests.image.repository }}:{{ .Values.tests.image.tag }}"
      imagePullPolicy: {{ .Values.tests.image.pullPolicy }}
      command:
        - wget
      args:
        - --spider
        - --timeout={{ .Values.tests.timeoutSeconds }}
        - "{{ include "[[ h ]].fullname" . }}:{{ [[ v ]].service.port }}"
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
            - ALL
{{- end }}
