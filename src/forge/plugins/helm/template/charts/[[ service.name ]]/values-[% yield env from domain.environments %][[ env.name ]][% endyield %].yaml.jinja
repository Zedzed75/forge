# =============================================================================
# values-[[ env.name ]].yaml — overrides of the "[[ env.name ]]" environment
# =============================================================================
# File generated by forge. It only contains the divergences with respect to
# values.yaml: everything that does not appear here keeps its default value.
#
# Target namespace of this environment: [[ env.namespace ]]
#
# Usage:
#   helm upgrade --install [[ service.name ]] ./charts/[[ service.name ]] \
#     --namespace [[ env.namespace ]] --create-namespace \
#     --values ./charts/[[ service.name ]]/values.yaml \
#     --values ./charts/[[ service.name ]]/values-[[ env.name ]].yaml
#
# The namespace is not a value of the chart: it is chosen by the --namespace
# option of Helm. It is recalled above for documentation purposes, and the
# Makefile of the project applies it automatically.
# =============================================================================

global:
  # Feeds the "environment" label set on every resource, which makes it possible
  # to filter by environment with kubectl -l environment=[[ env.name ]].
  environment: [[ env.name | yaml_scalar ]]

[% for component in domain.components %]
[% set override = env.components[component.name] %]
[% set tag_differs = override.image_tag or domain.image.strategy == "per_env" %]
[% set has_override = override.replicas is not none or tag_differs or override.resources is not none or override.hpa_enabled is not none or override.pdb_enabled is not none or override.ingress_host is not none %]
[% if has_override %]
# -----------------------------------------------------------------------------
# Component "[[ component.name ]]"
# -----------------------------------------------------------------------------
[# A component without the slightest override writes NOTHING here: a "<name>:"
   key with no content amounts to null in YAML, and would erase the whole block
   of values.yaml. #]
[[ component.name ]]:
[% if override.replicas is not none %]
  # "[[ env.name ]]" profile: [[ override.replicas ]] replica(s).
  replicaCount: [[ override.replicas ]]
[% endif %]
[% if override.image_tag %]
  image:
    # Tag specific to this environment ("per_env" tag strategy).
    tag: [[ override.image_tag | yaml_scalar ]]
[% elif domain.image.strategy == "per_env" %]
  image:
    # "per_env" tag strategy: fill in here the tag deployed on [[ env.name ]].
    # Left empty, the chart falls back on the appVersion of Chart.yaml.
    tag: ""
[% endif %]
[% if override.resources is not none %]
  # Resources adjusted for this environment.
  resources:
    requests:
      cpu: [[ override.resources.cpu_request | yaml_scalar ]]
      memory: [[ override.resources.memory_request | yaml_scalar ]]
    limits:
      cpu: [[ override.resources.cpu_limit | yaml_scalar ]]
      memory: [[ override.resources.memory_limit | yaml_scalar ]]
[% endif %]
[% if override.hpa_enabled is not none %]
[% if override.hpa_enabled %]
  # "[[ env.name ]]" profile: autoscaling enabled. The number of replicas is then
  # imposed by the HorizontalPodAutoscaler, between hpa.minReplicas and
  # hpa.maxReplicas; replicaCount stops being rendered in the manifest, failing
  # which Helm and the autoscaler would fight over the value.
[% else %]
  # "[[ env.name ]]" profile: autoscaling disabled. The number of replicas stays
  # the one replicaCount above sets.
[% endif %]
  hpa:
    enabled: [[ override.hpa_enabled | to_yaml ]]
[% endif %]
[% if override.pdb_enabled is not none %]
[% if override.pdb_enabled %]
  # "[[ env.name ]]" profile: disruption budget active; the node drains will have
  # to respect pdb.minAvailable.
[% else %]
  # "[[ env.name ]]" profile: disruption budget disabled; with a single replica,
  # minAvailable: 1 would make any node drain impossible.
[% endif %]
  pdb:
    enabled: [[ override.pdb_enabled | to_yaml ]]
[% endif %]
[% if override.ingress_host is not none %]
  # Host served by the Ingress in this environment.
[% if env.domain %]
  # Derived from the domain declared for "[[ env.name ]]" ([[ env.domain ]]): that
  # domain already carrying the environment, its name is not inserted again.
[% elif env.profile.host_includes_env %]
  # Derived from the base domain of the component, with the name of the
  # environment inserted: that is what distinguishes the non-production hosts.
[% else %]
  # Derived from the base domain of the component, with no environment infix:
  # this environment is production.
[% endif %]
  ingress:
    host: [[ override.ingress_host | yaml_scalar ]]
[% endif %]

[% endif %]
[% endfor %]
[% if env.extra_values %]

# -----------------------------------------------------------------------------
# Free values of this environment
# -----------------------------------------------------------------------------
[# ------------------------------------------------------------------------ #]
[# `helm.environments.<env>.extra_values`: what the specification asks to    #]
[# inject as it is. The original generator rendered it nowhere, so that      #]
[# these values disappeared silently.                                       #]
[# ------------------------------------------------------------------------ #]
# Values specific to this environment, taken as they are from forge.yml
# (helm.environments.[[ env.name ]].extra_values). forge does not interpret
# them: they are merged by Helm like any other values override.
[[ env.extra_values | to_yaml ]]
[% endif %]
