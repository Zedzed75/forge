# =============================================================================
# values.yaml — default values of the "[[ service.name ]]" chart
# =============================================================================
# File generated by forge. It contains the values common to every environment.
# The divergences specific to an environment live in the
# values-<environment>.yaml files, which only redefine what changes.
#
# Priority order applied by Helm, from the weakest to the strongest:
#   values.yaml  <  values-<env>.yaml  <  --set on the command line
#
# Every block is preceded by a comment stating its role, the accepted values and
# the default value chosen.
# =============================================================================

# -----------------------------------------------------------------------------
# Global values
# -----------------------------------------------------------------------------
# The "global" block is the only one propagated automatically to the sub-charts
# by Helm. What must stay consistent at the scale of the project is therefore put
# there.
global:
  # Registry the images of every component come from.
  # Examples: docker.io, ghcr.io, quay.io, registry.gitlab.com
  imageRegistry: [[ domain.image.registry | yaml_scalar ]]

  # Secrets of type kubernetes.io/dockerconfigjson allowing the images to be
  # pulled from a private registry. List of { name: <name of the secret> }.
[% if domain.image.pull_secret_name %]
  imagePullSecrets:
    - name: [[ domain.image.pull_secret_name | yaml_scalar ]]
[% else %]
  imagePullSecrets: []
[% endif %]

  # Name of the current environment. Left empty here: each values-<env>.yaml
  # fills it in, and it feeds the "environment" label set on every resource of
  # the chart.
  environment: ""

# -----------------------------------------------------------------------------
# Naming of the resources
# -----------------------------------------------------------------------------
# By default, the resources are named <release>-<chart>. These two keys make it
# possible to deviate from that rule without touching the templates.
#   nameOverride     : replaces the name of the chart in the composed names;
#   fullnameOverride : replaces the name entirely, release included.
nameOverride: ""
fullnameOverride: ""

[% for component in domain.components %]
# =============================================================================
# Component "[[ component.name ]]" ([[ component.kind ]])
# =============================================================================
[[ component.name ]]:
  # Makes it possible to disable the component entirely without deleting its
  # templates. Useful to enable a worker in production only, for example.
  enabled: true

  # Desired number of replicas. Overridden per environment.
  replicaCount: [[ component.replicas ]]

  # ---------------------------------------------------------------------------
  # Image of the container
  # ---------------------------------------------------------------------------
  image:
    # Repository, without the registry: that one comes from global.imageRegistry.
    repository: [[ component.image_repository | yaml_scalar ]]

[% if domain.image.strategy == "appVersion" %]
    # Tag left empty deliberately: the templates then fall back on the appVersion
    # of Chart.yaml. This is the recommended Helm practice, it avoids the tag and
    # the version of the chart diverging silently.
    tag: ""
[% elif domain.image.strategy == "fixed" %]
    # Frozen tag, identical in every environment.
    tag: [[ domain.image.tag | yaml_scalar ]]
[% else %]
    # Tag left empty here: each values-<env>.yaml imposes its own.
    tag: ""
[% endif %]

    # Always : pulls the image on every start, indispensable with a moving tag of
    #          the "latest" kind.
    # IfNotPresent : only queries the registry if the image is missing locally.
    # Never : never queries the registry, reserved for preloaded images.
    pullPolicy: [[ domain.image.pull_policy ]]

  # ---------------------------------------------------------------------------
  # Port exposed by the container
  # ---------------------------------------------------------------------------
  # The name of the port is taken up by the Service and, where applicable, by the
  # probes and the metrics collection. Fifteen characters maximum, a Kubernetes
  # constraint on port names.
  containerPort: [[ component.container_port ]]
  portName: [[ component.port_name | yaml_scalar ]]

[% if component.command or component.args %]
  # ---------------------------------------------------------------------------
  # Start command
  # ---------------------------------------------------------------------------
  # Replaces the ENTRYPOINT and the CMD of the image. That is how a worker is
  # distinguished from an API while sharing the same image.
  command:[[ component.command | yaml_value(4) ]]
  args:[[ component.args | yaml_value(4) ]]
[% else %]
  # Start command. Empty lists: the ENTRYPOINT of the image is kept.
  command: []
  args: []
[% endif %]

[% if component.has.service %]
  # ---------------------------------------------------------------------------
  # Service
  # ---------------------------------------------------------------------------
  service:
    enabled: true

    # ClusterIP : reachable from the cluster only (recommended default).
    # NodePort : opens a port on every node, to be reserved for development.
    # LoadBalancer : requests an external address from the cloud provider.
    type: [[ component.service.type ]]

    # Port exposed by the Service, redirected to containerPort.
    port: [[ component.service.port ]]
[% if component.service.headless %]

    # clusterIP: None — headless Service, indispensable to a StatefulSet in order
    # to give each pod a stable and individual DNS name.
    headless: true
[% endif %]

    # Annotations of the Service, for example to drive a cloud LoadBalancer.
    annotations:[[ component.service.annotations | yaml_value(6) ]]

[% endif %]
[% if component.has.ingress %]
  # ---------------------------------------------------------------------------
  # Ingress
  # ---------------------------------------------------------------------------
  ingress:
    # Generates the Ingress or not. At false, the component stays reachable by its
    # Service inside the cluster, but no longer from the outside.
    enabled: true

    # Targeted Ingress controller, written in ingressClassName.
    # Usual values: nginx | traefik
    # Never double this key with the kubernetes.io/ingress.class annotation:
    # emitting both at once is refused.
    className: [[ component.ingress.class_name | yaml_scalar ]]

    # HTTP host served by the rule. Left empty here: each values-<env>.yaml sets
    # its own, derived from the domain of the environment. Empty, the rule is
    # omitted entirely rather than writing a null host, which the schema refuses.
    host: ""

    # Path served, and comparison mode of that path:
    #   Exact : the path must match character for character;
    #   Prefix : matching by segments (/api covers /api/v1);
    #   ImplementationSpecific : the rule is left to the controller.
    # pathType is mandatory on every path: it is the omission most frequently
    # refused by strict schema validation.
    path: [[ component.ingress.path | yaml_scalar ]]
    pathType: [[ component.ingress.path_type | yaml_scalar ]]

    # TLS termination of this host. The tls block of the manifest is entirely
    # absent when enabled is false: a "tls: []" would be refused.
    tls:
      enabled: [[ component.ingress.tls | to_yaml ]]

      # cert-manager ClusterIssuer in charge of issuing the certificate.
      issuer: [[ component.ingress.issuer | yaml_scalar ]]

      # Name of the Secret carrying the certificate. Empty = <resource>-tls,
      # derived from the name of the component. The certificate must cover exactly
      # the host above, failing which the connection fails at runtime while the
      # manifest stays valid.
      secretName: ""

    # Annotations set on the Ingress: URL rewriting, maximum body size, HTTPS
    # redirection... They depend on the controller chosen.
    annotations:[[ component.ingress.annotations | yaml_value(6) ]]

[% endif %]
  # ---------------------------------------------------------------------------
  # Health probes
  # ---------------------------------------------------------------------------
  # liveness : a failure causes the restart of the container.
  # readiness : a failure removes the pod from the endpoints of the Service,
  #             without killing it.
  # startup : suspends the two others as long as the application has not started;
  #           to be enabled for an application slow to initialise.
  probes:
    enabled: [[ component.probes.enabled | to_yaml ]]
    liveness:
      path: [[ component.probes.liveness_path | yaml_scalar ]]
      initialDelaySeconds: [[ component.probes.initial_delay_seconds ]]
      periodSeconds: [[ component.probes.period_seconds ]]
      timeoutSeconds: [[ component.probes.timeout_seconds ]]
      failureThreshold: [[ component.probes.failure_threshold ]]
    readiness:
      path: [[ component.probes.readiness_path | yaml_scalar ]]
      initialDelaySeconds: [[ component.probes.initial_delay_seconds ]]
      periodSeconds: [[ component.probes.period_seconds ]]
      timeoutSeconds: [[ component.probes.timeout_seconds ]]
      failureThreshold: [[ component.probes.failure_threshold ]]
    startup:
      enabled: [[ component.probes.startup_enabled | to_yaml ]]
      path: [[ component.probes.liveness_path | yaml_scalar ]]
      periodSeconds: [[ component.probes.period_seconds ]]
      # 30 attempts x periodSeconds: maximum duration granted to the startup.
      failureThreshold: 30

  # ---------------------------------------------------------------------------
  # CPU and memory resources
  # ---------------------------------------------------------------------------
  # requests : what the scheduler reserves, and therefore what determines which
  #            node the pod can land on.
  # limits   : ceiling applied at runtime. Exceeding the memory limit kills the
  #            container (OOMKilled); exceeding the CPU limit slows it down.
  # Profile chosen at generation time: [[ component.resources.profile ]]
  resources:
    requests:
      cpu: [[ component.resources.cpu_request | yaml_scalar ]]
      memory: [[ component.resources.memory_request | yaml_scalar ]]
    limits:
      cpu: [[ component.resources.cpu_limit | yaml_scalar ]]
      memory: [[ component.resources.memory_limit | yaml_scalar ]]

  # ---------------------------------------------------------------------------
  # Security context
  # ---------------------------------------------------------------------------
[% if component.security.strict %]
  # Strict hardening requested at generation time: non-root container, read-only
  # root file system, all the capabilities dropped.
  # If the application needs to write, mount an emptyDir volume rather than
  # setting readOnlyRootFilesystem back to false.
[% else %]
  # Hardening relaxed on request. Set these values back to strict as soon as the
  # application allows it: it is the least costly protection there is.
[% endif %]
  podSecurityContext:
    runAsNonRoot: [[ component.security.run_as_non_root | to_yaml ]]
    runAsUser: [[ component.security.run_as_user ]]
    runAsGroup: [[ component.security.run_as_group ]]
    # fsGroup sets the owning group of the mounted volumes, failing which a
    # non-root container cannot write to them.
    fsGroup: [[ component.security.fs_group ]]
    seccompProfile:
      type: [[ component.security.seccomp_profile ]]
  securityContext:
    allowPrivilegeEscalation: [[ component.security.allow_privilege_escalation | to_yaml ]]
    readOnlyRootFilesystem: [[ component.security.read_only_root_filesystem | to_yaml ]]
    capabilities:
      drop:[[ component.security.drop_capabilities | yaml_value(8) ]]

  # ---------------------------------------------------------------------------
  # Placement and metadata of the pod
  # ---------------------------------------------------------------------------
  # Left empty by default. To be filled in to constrain the scheduling, for
  # example on a dedicated node group.
  nodeSelector: {}
  tolerations: []
  affinity: {}

  # Annotations and labels added to the pod, in addition to the standard labels.
  podAnnotations: {}
  podLabels: {}

  # Additional environment variables, in the Kubernetes format.
  # Example:
  #   extraEnv:
  #     - name: DATABASE_URL
  #       valueFrom:
  #         secretKeyRef:
  #           name: [[ component.name ]]-database
  #           key: url
  extraEnv: []
[% if component.has.configmap %]

  # ---------------------------------------------------------------------------
  # ConfigMap — non sensitive configuration
  # ---------------------------------------------------------------------------
  config:
    # Generates the ConfigMap or not. At false, the injection into the container
    # disappears as well: nothing references an absent resource any more.
    enabled: true

    # Injection mode into the container:
    #   env  : each key becomes an environment variable (envFrom);
    #   file : the ConfigMap is mounted as files under mountPath, one file per
    #          key — the only usable form if the application reads a file.
    mountAs: [[ component.config.mount_as | yaml_scalar ]]

    # Mount directory, used in "file" mode only.
    mountPath: "/etc/[[ component.name ]]"

    # Configuration keys and their values.
    # All the values are written as strings: a bare integer or boolean is refused
    # by the API, so the template always quotes them.
    # A change to this block restarts the pods, thanks to the checksum/config
    # fingerprint set on the pod template.
[% if component.config["keys"] %]
    data:
[% for key in component.config["keys"] %]
      [[ key ]]: ""
[% endfor %]
[% else %]
    # No declared key: "{}" and not an empty block, which would amount to null.
    data: {}
[% endif %]
[% endif %]
[% if component.has.secret %]

  # ---------------------------------------------------------------------------
  # Secret — placeholders for sensitive values
  # ---------------------------------------------------------------------------
  # forge never writes a secret value: this block only declares the expected
  # keys. Fill them in outside the repository (--set, vault, secrets operator),
  # never in a versioned file.
  secret:
    # Generates the Secret or not. False by default: as long as no value is
    # provided, it is better to create nothing than to create empty keys that
    # would make the application start with a silently wrong configuration.
    enabled: false

    # true  : the chart creates the Secret from the keys below;
    # false : the chart references existingSecret, managed outside the chart.
    create: true

    # Name of an existing Secret, used when create is false. Leaving it empty in
    # that case would prevent the pods from starting.
    existingSecret: ""

    # Type of Secret. "Opaque" suits arbitrary keys; a specialised type imposes
    # its own (kubernetes.io/tls requires tls.crt and tls.key) — do not mix the
    # two families of keys.
    type: "Opaque"

    # Injection mode into the container:
    #   env  : each key becomes an environment variable (envFrom);
    #   file : the Secret is mounted as files under mountPath.
    mountAs: [[ component.secret.mount_as | yaml_scalar ]]

    # Mount directory, used in "file" mode only.
    mountPath: "/etc/[[ component.name ]]/secrets"

    # Expected keys, in plain text (stringData). Never fill in the same key both
    # here and in a base64 data block: data would win without the slightest
    # warning.
[% if component.secret["keys"] %]
    stringData:
[% for key in component.secret["keys"] %]
      [[ key ]]: ""
[% endfor %]
[% else %]
    # No declared key: "{}" and not an empty block, which would amount to null.
    stringData: {}
[% endif %]
[% endif %]
[% if component.kind == "statefulset" %]

  # ---------------------------------------------------------------------------
  # Persistent volume
  # ---------------------------------------------------------------------------
  # A volumeClaimTemplate is IMMUTABLE: changing size, storageClass or accessMode
  # after the installation makes "helm upgrade" fail. The StatefulSet must then
  # be deleted without its pods (--cascade=orphan) and recreated; the volumes
  # already provisioned are kept.
  persistence:
    # Attaches a volume to each pod. Always true for a StatefulSet: without a
    # volume, its stable identity serves no purpose.
    enabled: [[ component.persistence.enabled | to_yaml ]]

    # Size requested for the volume, a Kubernetes quantity (10Gi, 500Mi).
    size: [[ component.persistence.size | yaml_scalar ]]

    # Name of a StorageClass, or "" for the default class of the cluster.
    # Mind the nuance: "" here means "default class", and the template then omits
    # the key from the manifest — a storageClassName: "" written explicitly would
    # mean "no class", which is different.
    storageClass: [[ component.persistence.storage_class | yaml_scalar ]]

    # Access mode of the volume:
    #   ReadWriteOnce : mounted read-write by a single node;
    #   ReadOnlyMany : read-only by several nodes;
    #   ReadWriteMany : read-write by several nodes (rare);
    #   ReadWriteOncePod : read-write by a single pod.
    accessMode: [[ component.persistence.access_mode | yaml_scalar ]]

    # Mount path in the container. The name of the volumeClaimTemplate and that
    # of the volumeMount must stay identical: the template takes care of it.
    mountPath: [[ component.persistence.mount_path | yaml_scalar ]]

  # ---------------------------------------------------------------------------
  # Update strategy of the pods
  # ---------------------------------------------------------------------------
  updateStrategy:
    # RollingUpdate : the pods are replaced one by one, from the highest ordinal
    #                 to the lowest;
    # OnDelete : no pod is replaced automatically; deleting a pod triggers its
    #            recreation at the new version.
    type: "RollingUpdate"

    # Ordinal from which the pods are updated: those with a lower ordinal stay at
    # the old version, which allows a progressive rollout. Used with
    # RollingUpdate only.
    partition: 0
[% endif %]
[% if component.cron is not none %]

  # ---------------------------------------------------------------------------
  # Schedule (CronJob)
  # ---------------------------------------------------------------------------
  cron:
    # Five-field schedule: minute hour day-of-month month day-of-week.
    schedule: [[ component.cron.schedule | yaml_scalar ]]

    # What to do if the previous run is still going at the next firing:
    #   Allow : start anyway | Forbid : skip | Replace : replace
    concurrencyPolicy: [[ component.cron.concurrency_policy | yaml_scalar ]]

    # Restart of the pod: OnFailure | Never. "Always" passes the schema
    # validation but is refused by the API for a Job.
    restartPolicy: [[ component.cron.restart_policy | yaml_scalar ]]

    # IANA time zone applied to the schedule (Europe/Paris). Empty = time zone of
    # the controller; the key is then omitted entirely from the manifest, a
    # timeZone: "" being refused by the API.
    timeZone: ""

    # Suspends the firings without deleting the object nor its history.
    suspend: false

    # Number of runs kept in the history, successful then failed.
    successfulJobsHistoryLimit: [[ component.cron.successful_jobs_history_limit ]]
    failedJobsHistoryLimit: [[ component.cron.failed_jobs_history_limit ]]

    # Number of retries before giving up on a run.
    backoffLimit: [[ component.cron.backoff_limit ]]

[% if component.cron.starting_deadline_seconds is not none %]
    # Maximum lateness tolerated, in seconds, before considering a firing as
    # missed rather than catching it up.
    startingDeadlineSeconds: [[ component.cron.starting_deadline_seconds ]]
[% else %]
    # Maximum lateness tolerated before considering a firing as missed.
    # null = no limit; fill in an integer of seconds to set one.
    startingDeadlineSeconds: null
[% endif %]
[% endif %]
[% if component.has.hpa %]

  # ---------------------------------------------------------------------------
  # Horizontal autoscaling
  # ---------------------------------------------------------------------------
  # Driven by the environment profile: disabled in development, enabled in
  # production by values-<env>.yaml.
  # When it is active, the template stops rendering replicaCount: Helm and the
  # HorizontalPodAutoscaler would otherwise fight over the number of replicas on
  # every update.
  # CPU autoscaling requires resources.requests.cpu above: without a reservation
  # the metric stays unknown and nothing happens, without any validator being
  # able to report it.
  hpa:
    enabled: false

    # Bounds of the number of replicas. minReplicas cannot exceed maxReplicas.
    minReplicas: [[ component.hpa.min_replicas ]]
    maxReplicas: [[ component.hpa.max_replicas ]]

    # Targeted average CPU usage, as a percentage of the requests. Integer
    # mandatory: the string "80" is refused.
    targetCPUUtilizationPercentage: [[ component.hpa.target_cpu ]]

[% if component.hpa.target_memory is not none %]
    # Targeted average memory usage, as a percentage of the requests. Integer.
    targetMemoryUtilizationPercentage: [[ component.hpa.target_memory ]]
[% else %]
    # Targeted average memory usage, as a percentage of the requests.
    # null = memory not watched; fill in an integer to add it.
    targetMemoryUtilizationPercentage: null
[% endif %]
[% endif %]
[% if component.has.pdb %]

  # ---------------------------------------------------------------------------
  # Voluntary disruption budget
  # ---------------------------------------------------------------------------
  # Protects the component from node drains and cluster upgrades.
  # Driven by the environment profile: disabled in development, where
  # minAvailable: 1 with a single replica would make any drain impossible.
  pdb:
    enabled: false

    # Number of pods that must stay available: an integer, or a percentage between
    # quotes ("50%"). minAvailable and maxUnavailable are mutually exclusive; this
    # chart only exposes the first, so as not to allow both to be written.
    minAvailable: [[ component.pdb.min_available | to_yaml ]]
[% endif %]
[% if component.has.serviceaccount %]

  # ---------------------------------------------------------------------------
  # ServiceAccount — identity of the component
  # ---------------------------------------------------------------------------
  serviceAccount:
    # true  : the chart creates a dedicated ServiceAccount;
    # false : the chart references an existing account, whose name must then be
    #         given below — otherwise the pods do not start.
    create: true

    # Name of the account. Empty = name derived from the component.
    name: ""

    # Annotations carrying the federated identity of the cloud provider, for
    # example eks.amazonaws.com/role-arn or iam.gke.io/gcp-service-account.
    annotations: {}

    # Mounts the Kubernetes API token in the pods. False as long as the component
    # does not call the API: that is one secret fewer exposed in the container.
    automountServiceAccountToken: false

  # ---------------------------------------------------------------------------
  # RBAC — rights of the ServiceAccount in the namespace
  # ---------------------------------------------------------------------------
  rbac:
    # Creates a Role and its RoleBinding, bound to the ServiceAccount above.
    # No cluster-scoped resource is produced by this chart.
    # roleRef is immutable: changing the targeted Role makes helm upgrade fail.
    create: [[ component.rbac.create | to_yaml ]]

    # Rules of the Role. Empty list = neither Role nor RoleBinding: a Role with no
    # rule is valid against the schema, but useless and misleading.
    # apiGroups must contain the empty string for the resources of the core group
    # (pods, configmaps, secrets). Example:
    #   rules:
    #     - apiGroups: [""]
    #       resources: ["configmaps"]
    #       verbs: ["get", "list", "watch"]
    rules:[[ component.rbac.rules | yaml_value(6) ]]
[% endif %]
[% if component.has.networkpolicy %]

  # ---------------------------------------------------------------------------
  # NetworkPolicy — network partitioning
  # ---------------------------------------------------------------------------
  # Closed by default, opened explicitly. Careful: an empty rule allows
  # EVERYTHING, whereas the absence of a rule forbids everything — the two look
  # alike and no validator tells them apart.
  networkPolicy:
    enabled: false

    # Allows the incoming traffic coming from the namespace of the component. At
    # false with no allowed namespace below, the list of incoming rules is written
    # empty: nothing enters any more, which is the intended behaviour for a
    # component nobody calls — a CronJob, for example.
    allowFromSameNamespace: [[ component.networkpolicy.allow_from_same_namespace | to_yaml ]]

    # Additional namespaces allowed on ingress, designated by their name
    # (kubernetes.io/metadata.name label, set automatically by Kubernetes).
    allowFromNamespaces:[[ component.networkpolicy.allow_from_namespaces | yaml_value(6) ]]

    # DNS resolution must stay allowed: as soon as Egress is declared, all the
    # outgoing traffic is cut, name resolution included, and the component reaches
    # nothing any more.
    allowDNS: [[ component.networkpolicy.allow_dns | to_yaml ]]

    # Allows all the outgoing traffic. False restricts it to the DNS above.
    allowEgressAll: [[ component.networkpolicy.allow_egress_all | to_yaml ]]
[% endif %]

[% endfor %]
[% if domain.extras.helm_tests %]
# -----------------------------------------------------------------------------
# Tests of the chart (helm test)
# -----------------------------------------------------------------------------
# Resources created only by "helm test", never by an ordinary installation. They
# check that the Service answers before validating a release.
tests:
  enabled: true
  image:
    # Image used by the test pod. Any image containing wget will do.
    repository: busybox
    tag: "1.36"
    pullPolicy: IfNotPresent
  # Maximum delay granted to the answer of the Service, in seconds.
  timeoutSeconds: 10
[% endif %]
