# =============================================================================
# .gitignore — artefacts that must never be versioned
# =============================================================================
# File generated by forge.
# =============================================================================

# Time series database of a Prometheus started locally
data/
prometheus-data/

# Local renders and exports
*.rendered.yml
rendered/

# Dashboards exported from a Grafana instance: they carry UIDs and data source
# identifiers specific to that instance, and would overwrite the ones forge
# generates.
grafana/dashboards/*.exported.json

# Secret files of the collector (scrape passwords, tokens)
web-config.yml
*.secret.yml

# Editors and file systems
.idea/
.vscode/
.DS_Store
*~
*.swp
