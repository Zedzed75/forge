[# --------------------------------------------------------------------- #]
[# JSON does not accept comments: what explains this file is in the       #]
[# README of the domain, and in the "description" field below.            #]
[# --------------------------------------------------------------------- #]
{
  "annotations": {
    "list": []
  },
  "description": [[ ("Generated by forge for the " ~ service.name ~ " service. One panel per alert: what is watched is what is looked at. The expressions plot the quantity itself, not the alerting condition, so that the threshold crossing can be seen coming. Reference environment: " ~ domain.default_env ~ ".") | tojson ]],
  "editable": true,
  "graphTooltip": 1,
  "panels": [
[% for panel in domain.dashboard_panels %]
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": [[ ("Family " ~ panel.family ~ ". Associated alert: " ~ panel.alert ~ ((", threshold " ~ panel.threshold) if panel.threshold else "") ~ ".") | tojson ]],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": [[ (loop.index0 % 2) * 12 ]],
        "y": [[ (loop.index0 // 2) * 8 ]]
      },
      "id": [[ loop.index ]],
      "targets": [
        {
          "editorMode": "code",
          "expr": [[ panel.expr | tojson ]],
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": [[ panel.title | tojson ]],
      "type": "timeseries"
    }[% if not loop.last %],[% endif %]

[% endfor %]
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "forge",
    [[ service.name | tojson ]]
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": [[ (service.name ~ " — " ~ domain.default_env) | tojson ]],
  "uid": [[ (service.name ~ "-" ~ domain.default_env) | tojson ]],
  "version": 1
}
