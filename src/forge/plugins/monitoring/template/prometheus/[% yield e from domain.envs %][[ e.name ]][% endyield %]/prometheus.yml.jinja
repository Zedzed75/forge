[# --------------------------------------------------------------------- #]
[# La balise `yield` du chemin ne porte qu'un nom : les listes completes   #]
[# sont relues ici. Les noms de gabarit sont volontairement courts —       #]
[# Windows plafonne un chemin a 260 caracteres, et le depot de gabarit est #]
[# clone dans un repertoire temporaire avant le rendu.                     #]
[# --------------------------------------------------------------------- #]
[% set env = domain.environments | selectattr("name", "equalto", e.name) | first %]
# =============================================================================
# prometheus.yml — collecte de « [[ service.name ]] » en environnement [[ env.name ]]
# =============================================================================
# Fichier généré par forge. Ne l'éditez pas à la main : modifiez `forge.yml` à la
# racine du dépôt, puis relancez `forge generate`.
#
# Une configuration par environnement, et non une seule partagée : les seuils
# d'alerte diffèrent, le namespace observé aussi. Une configuration commune
# devrait porter des filtres larges et des seuils moyens, c'est-à-dire ne bien
# servir aucun des deux.
#
# Les cibles sont ÉCRITES ici, pas découvertes. C'est un choix : une cible
# jamais déclarée ne produit aucune série, donc aucune alerte. Le silence n'est
# pas la santé. Si vos cibles changent souvent, remplacez `static_configs` par
# `file_sd_configs` ou par une découverte Kubernetes — c'est une modification
# locale, le reste du fichier ne bouge pas.
# =============================================================================

global:
  # Période entre deux collectes. Elle borne la finesse de tout ce qui suit :
  # une fenêtre `rate()` doit couvrir au moins deux collectes.
  scrape_interval: [[ domain.scrape.interval ]]

  # Délai au-delà duquel une collecte est abandonnée. Toujours inférieur à
  # l'intervalle, sans quoi les collectes se chevauchent.
  scrape_timeout: [[ domain.scrape.timeout ]]

  # Étiquettes ajoutées à tout ce que cette instance produit. Elles permettent
  # de distinguer les environnements dans un Alertmanager commun.
  external_labels:
    service: [[ service.name | yaml_scalar ]]
    env: [[ env.name | yaml_scalar ]]

# Règles d'alerte de cet environnement. Le chemin est relatif à ce fichier.
rule_files:
  - ../../rules/[[ env.name ]]/*.yml

scrape_configs:
  # ---------------------------------------------------------------------------
  # Le service lui-même.
  # ---------------------------------------------------------------------------
  - job_name: [[ domain.job_name | yaml_scalar ]]
    metrics_path: [[ domain.scrape.metrics_path | yaml_scalar ]]
    static_configs:
[% if env.targets %]
      - targets:
[% for cible in env.targets %]
          - [[ cible | yaml_scalar ]]
[% endfor %]
[% if env.labels %]
        labels:
[% for cle, valeur in env.labels | dictsort %]
          [[ cle ]]: [[ valeur | yaml_scalar ]]
[% endfor %]
[% endif %]
[% else %]
      # AUCUNE CIBLE DÉCLARÉE pour cet environnement : rien n'y sera collecté,
      # et aucune alerte ne pourra se déclencher. Renseignez
      # monitoring.environments.[[ env.name ]].targets dans forge.yml.
      - targets: []
[% endif %]
[% if domain.blackbox.needed %]

  # ---------------------------------------------------------------------------
  # Sonde externe, via le blackbox exporter.
  # ---------------------------------------------------------------------------
  # Le ballet de relabels ci-dessous n'est pas décoratif : sans lui, Prometheus
  # collecterait l'exporter lui-même, qui répond toujours. L'adresse à sonder
  # passe par `__param_target`, devient l'étiquette `instance`, et `__address__`
  # est finalement remplacé par l'adresse de l'exporter.
  - job_name: [[ domain.blackbox.job | yaml_scalar ]]
    metrics_path: /probe
    params:
      module: [[[ domain.blackbox.module | yaml_scalar ]]]
    static_configs:
[% if env.probe_urls %]
      - targets:
[% for url in env.probe_urls %]
          - [[ url | yaml_scalar ]]
[% endfor %]
        labels:
          env: [[ env.name | yaml_scalar ]]
[% else %]
      # AUCUNE URL SONDÉE pour cet environnement : les alertes de la famille
      # « probe » ne se déclencheront jamais. Renseignez
      # monitoring.environments.[[ env.name ]].probe_urls dans forge.yml.
      - targets: []
[% endif %]
    relabel_configs:
      # 1. l'adresse listée devient le paramètre `target` de la requête ;
      - source_labels: [__address__]
        target_label: __param_target
      # 2. ce paramètre devient l'étiquette `instance`, celle que les alertes
      #    citent dans leurs annotations ;
      - source_labels: [__param_target]
        target_label: instance
      # 3. et l'adresse réellement interrogée devient celle de l'exporter.
      - target_label: __address__
        replacement: [[ domain.blackbox.address | yaml_scalar ]]
[% endif %]
