[# --------------------------------------------------------------------- #]
[# The `yield` tag of the path only carries a name: the complete lists are #]
[# read back here. The template names are deliberately short -- Windows    #]
[# caps a path at 260 characters, and the template repository is cloned    #]
[# into a temporary directory before the render.                           #]
[# --------------------------------------------------------------------- #]
[% set env = domain.environments | selectattr("name", "equalto", e.name) | first %]
# =============================================================================
# prometheus.yml — collection of "[[ service.name ]]" in the [[ env.name ]] environment
# =============================================================================
# File generated by forge. Do not edit it by hand: modify `forge.yml` at the root
# of the repository, then run `forge generate` again.
#
# One configuration per environment, and not a single shared one: the alerting
# thresholds differ, and so does the observed namespace. A common configuration
# would have to carry wide filters and average thresholds, that is to say serve
# neither of the two well.
#
# The targets are WRITTEN here, not discovered. That is a choice: a target never
# declared produces no series, and therefore no alert. Silence is not health. If
# your targets change often, replace `static_configs` with `file_sd_configs` or
# with a Kubernetes discovery — that is a local modification, the rest of the file
# does not move.
# =============================================================================

global:
  # Period between two collections. It bounds the granularity of everything that
  # follows: a `rate()` window must cover at least two collections.
  scrape_interval: [[ domain.scrape.interval ]]

  # Delay beyond which a collection is abandoned. Always lower than the
  # interval, failing which the collections overlap.
  scrape_timeout: [[ domain.scrape.timeout ]]

  # Labels added to everything this instance produces. They make it possible to
  # tell the environments apart in a shared Alertmanager.
  external_labels:
    service: [[ service.name | yaml_scalar ]]
    env: [[ env.name | yaml_scalar ]]

# Alerting rules of this environment. The path is relative to this file.
rule_files:
  - ../../rules/[[ env.name ]]/*.yml

scrape_configs:
  # ---------------------------------------------------------------------------
  # The service itself.
  # ---------------------------------------------------------------------------
  - job_name: [[ domain.job_name | yaml_scalar ]]
    metrics_path: [[ domain.scrape.metrics_path | yaml_scalar ]]
    static_configs:
[% if env.targets %]
      - targets:
[% for target in env.targets %]
          - [[ target | yaml_scalar ]]
[% endfor %]
[% if env.labels %]
        labels:
[% for key, value in env.labels | dictsort %]
          [[ key ]]: [[ value | yaml_scalar ]]
[% endfor %]
[% endif %]
[% else %]
      # NO TARGET DECLARED for this environment: nothing will be collected there,
      # and no alert will be able to fire. Fill in
      # monitoring.environments.[[ env.name ]].targets in forge.yml.
      - targets: []
[% endif %]
[% if domain.blackbox.needed %]

  # ---------------------------------------------------------------------------
  # External probe, through the blackbox exporter.
  # ---------------------------------------------------------------------------
  # The ballet of relabels below is not decorative: without it, Prometheus would
  # collect the exporter itself, which always answers. The address to probe goes
  # through `__param_target`, becomes the `instance` label, and `__address__` is
  # finally replaced by the address of the exporter.
  - job_name: [[ domain.blackbox.job | yaml_scalar ]]
    metrics_path: /probe
    params:
      module: [[[ domain.blackbox.module | yaml_scalar ]]]
    static_configs:
[% if env.probe_urls %]
      - targets:
[% for url in env.probe_urls %]
          - [[ url | yaml_scalar ]]
[% endfor %]
        labels:
          env: [[ env.name | yaml_scalar ]]
[% else %]
      # NO URL PROBED for this environment: the alerts of the "probe" family will
      # never fire. Fill in
      # monitoring.environments.[[ env.name ]].probe_urls in forge.yml.
      - targets: []
[% endif %]
    relabel_configs:
      # 1. the listed address becomes the `target` parameter of the request;
      - source_labels: [__address__]
        target_label: __param_target
      # 2. that parameter becomes the `instance` label, the one the alerts quote
      #    in their annotations;
      - source_labels: [__param_target]
        target_label: instance
      # 3. and the address really queried becomes that of the exporter.
      - target_label: __address__
        replacement: [[ domain.blackbox.address | yaml_scalar ]]
[% endif %]
