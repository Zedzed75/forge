[% set env = domain.environments | selectattr("name", "equalto", e.name) | first %]
[% set family = domain.families | selectattr("name", "equalto", f.name) | first %]
[% set group = env.rules[f.name] %]
# =============================================================================
# [[ family.name ]] — [[ family.summary ]]
# =============================================================================
# Alerting rules of "[[ service.name ]]", environment [[ env.name ]].
# File generated by forge.
#
[[ family.details | comment(width=76) ]]
[% if family.exporters %]
#
# Requires: [[ family.exporters | join(', ') ]].
[% endif %]
#
# POINTS TO WATCH
[% for trap in family.traps %]
#
[[ trap | comment(width=76) ]]
[% endfor %]
#
# Every alert of this file is put to the test by a unit test:
#   promtool test rules tests/[[ env.name ]]/[[ family.name ]].yml
# =============================================================================

groups:
  - name: [[ group.group | yaml_scalar ]]
    rules:
[% for alert in group.alerts %]
[% if not loop.first %]

[% endif %]
      # -----------------------------------------------------------------------
      # [[ alert.summary ]]
[% if alert.threshold_field %]
      # Threshold: [[ alert.threshold ]] ([[ alert.threshold_unit ]]), adjustable through
      # monitoring.environments.[[ env.name ]].thresholds.[[ alert.threshold_field ]]
      # in forge.yml.
[% endif %]
      # -----------------------------------------------------------------------
      - alert: [[ alert.name ]]
        expr: |
          [[ alert.expr | indent(10) ]]
        # The condition has to hold for this duration before firing: without it,
        # the slightest oscillation wakes somebody up.
        for: [[ alert.for ]]
        labels:
[% for key, value in alert.labels | dictsort %]
          [[ key ]]: [[ value | yaml_scalar ]]
[% endfor %]
        annotations:
          summary: [[ alert.summary | yaml_scalar ]]
          description: [[ alert.description | yaml_scalar ]]
[% endfor %]
