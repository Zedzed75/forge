[% set env = domain.environments | selectattr("name", "equalto", e.name) | first %]
[% set groupe = env.rules[f.name] %]
# =============================================================================
# Tests unitaires des alertes « [[ f.name ]] » — environnement [[ env.name ]]
# =============================================================================
# Fichier généré par forge, joué par :
#
#   promtool test rules tests/[[ env.name ]]/[[ f.name ]].yml
#
# Ce que ces tests vérifient, et que rien d'autre ne vérifie : **que les alertes
# se déclenchent réellement**. `promtool check rules` ne contrôle que la
# syntaxe — une règle irréprochable peut citer une métrique qui n'existe pas, un
# libellé mal orthographié, ou comparer du mauvais côté du seuil, et rester
# muette pour toujours.
#
# Les séries ci-dessous sont SYNTHÉTIQUES : promtool les fabrique lui-même, elles
# n'ont besoin d'exister nulle part. Les noms d'instance, de pod et de conteneur
# sont donc des noms de test, jamais des noms réels.
#
# Les annotations attendues sont calculées à partir des mêmes valeurs que la
# règle : elles ne peuvent pas diverger de sa formulation.
# =============================================================================

rule_files:
  - ../../rules/[[ env.name ]]/[[ f.name ]].yml

# Rythme auquel promtool évalue les règles pendant le test.
evaluation_interval: 1m

tests:
[% for alerte in groupe.alerts %]
[% if not loop.first %]

[% endif %]
  # ---------------------------------------------------------------------------
  # [[ alerte.name ]] — [[ alerte.summary ]]
  # ---------------------------------------------------------------------------
  - interval: 1m
    input_series:
[% for serie in alerte.test.series %]
      - series: [[ serie.series | yaml_scalar ]]
        values: [[ serie.points | yaml_scalar ]]
[% endfor %]
    alert_rule_test:
        # L'instant d'évaluation dépasse la clause `for` de la règle
        # ([[ alerte.for ]]) : l'alerte doit donc être passée de « pending » à
        # « firing ».
      - eval_time: [[ alerte.test.eval_time ]]
        alertname: [[ alerte.name ]]
        exp_alerts:
          - exp_labels:
[% for cle, valeur in alerte.test.exp_labels | dictsort %]
              [[ cle ]]: [[ valeur | yaml_scalar ]]
[% endfor %]
            exp_annotations:
              summary: [[ alerte.test.exp_annotations.summary | yaml_scalar ]]
              description: [[ alerte.test.exp_annotations.description | yaml_scalar ]]
[% endfor %]
