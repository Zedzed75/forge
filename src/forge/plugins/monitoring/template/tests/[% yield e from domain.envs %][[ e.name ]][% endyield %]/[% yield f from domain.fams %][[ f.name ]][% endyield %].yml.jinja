[% set env = domain.environments | selectattr("name", "equalto", e.name) | first %]
[% set group = env.rules[f.name] %]
# =============================================================================
# Unit tests of the "[[ f.name ]]" alerts — environment [[ env.name ]]
# =============================================================================
# File generated by forge, played by:
#
#   promtool test rules tests/[[ env.name ]]/[[ f.name ]].yml
#
# What these tests check, and that nothing else checks: **that the alerts really
# fire**. `promtool check rules` only controls the syntax — a faultless rule can
# quote a metric that does not exist, a misspelled label, or compare on the wrong
# side of the threshold, and stay mute for ever.
#
# The series below are SYNTHETIC: promtool builds them itself, they do not need
# to exist anywhere. The instance, pod and container names are therefore test
# names, never real names.
#
# The expected annotations are computed from the same values as the rule: they
# cannot diverge from its wording.
# =============================================================================

rule_files:
  - ../../rules/[[ env.name ]]/[[ f.name ]].yml

# Pace at which promtool evaluates the rules during the test.
evaluation_interval: 1m

tests:
[% for alert in group.alerts %]
[% if not loop.first %]

[% endif %]
  # ---------------------------------------------------------------------------
  # [[ alert.name ]] — [[ alert.summary ]]
  # ---------------------------------------------------------------------------
  - interval: 1m
    input_series:
[% for serie in alert.test.series %]
      - series: [[ serie.series | yaml_scalar ]]
        values: [[ serie.points | yaml_scalar ]]
[% endfor %]
    alert_rule_test:
        # The evaluation instant exceeds the `for` clause of the rule
        # ([[ alert.for ]]): the alert must therefore have moved from "pending" to
        # "firing".
      - eval_time: [[ alert.test.eval_time ]]
        alertname: [[ alert.name ]]
        exp_alerts:
          - exp_labels:
[% for key, value in alert.test.exp_labels | dictsort %]
              [[ key ]]: [[ value | yaml_scalar ]]
[% endfor %]
            exp_annotations:
              summary: [[ alert.test.exp_annotations.summary | yaml_scalar ]]
              description: [[ alert.test.exp_annotations.description | yaml_scalar ]]
[% endfor %]
