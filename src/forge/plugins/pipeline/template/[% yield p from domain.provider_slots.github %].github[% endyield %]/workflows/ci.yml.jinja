# =============================================================================
# ci.yml — integration chain of "[[ service.name ]]"
# =============================================================================
# File generated by forge. Do not edit it by hand: modify `forge.yml` at the root
# of the repository, then run `forge generate` again — or `forge update --only
# pipeline` to receive only the evolutions of the template.
#
# This file was not written domain by domain: each domain declared in `forge.yml`
# said itself which tools had to be run and in which directory. Adding a section
# to `forge.yml` therefore adds a job here, without this template changing.
#
# Domains taken into account:
[% for d in domain.domains %]
#   - [[ d.title ]] ([[ d.name ]]) — [[ d.validator_count ]] validation command(s)[[ (', deploys ' ~ d.deploys|join(', ')) if d.deploys else '' ]]
[% endfor %]
[% if domain.undeployed %]
#
# Domains WITHOUT a deployment command — forge invents none, so they are absent
# from the deployment jobs: [[ domain.undeployed | join(', ') ]].
[% endif %]
[% if domain.unknown_tools %]
#
# WARNING — forge does not know how to install: [[ domain.unknown_tools | join(', ') ]].
# The steps concerned fail saying so, rather than letting the job fall over
# further on with a "command not found". Complete them.
[% endif %]
#
# No credential is written in this file. Access goes through the secrets of the
# repository (`${{ secrets.* }}`) or through the token provided as standard.
#
# Each action is pinned to a commit SHA rather than to a tag. A tag can be
# repointed at new code by whoever owns the action, and these jobs run in your
# repository with your permissions — a moved tag is code you never reviewed,
# running where you cannot see it. The comment beside each SHA is the release
# that SHA is.
#
# A pin does not update itself. Add a `.github/dependabot.yml` enabling the
# `github-actions` ecosystem and these pins become update pull requests you read
# before merging, which is the posture forge keeps on its own CI.
# =============================================================================

name: [[ service.name | yaml_scalar ]]

on:
  push:
    branches:
[% for branch in domain.trigger.branches %]
      - [[ branch | yaml_scalar ]]
[% endfor %]
[% if domain.trigger.on_tag %]
    tags:
      - "v*"
[% endif %]
[% if domain.trigger.on_pull_request %]
  # A validation only really prevents anything before the merge.
  pull_request:
[% endif %]

# Minimal rights: only reading the repository is granted by default.
permissions:
  contents: read
[% if domain.build_job %]
  # Necessary in order to publish the image in the registry of the repository.
  packages: write
[% endif %]

# One run per reference: a push that replaces another cancels the previous one,
# rather than queueing behind it.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
[% for job in domain.jobs %]
  [[ job.key ]]:
    name: [[ job.name | yaml_scalar ]]
    runs-on: [[ domain.runner | yaml_scalar ]]
[% if job.needs %]
    needs:
[% for prerequisite in job.needs %]
      - [[ prerequisite ]]
[% endfor %]
[% endif %]
[% if job.default_branch_only %]
    # Only starts from the default branch: a pull request publishes nothing and
    # deploys nothing.
    if: github.ref == 'refs/heads/[[ domain.default_branch ]]'
[% endif %]
[% if job.environment %]
    # This is where GitHub attaches the human approval: it is configured in the
    # settings of the repository (Settings > Environments > [[ job.environment ]]),
    # not in this file. Without "required reviewers" on this environment,
[% if job.manual %]
    # the deployment will start without anybody having approved it — whereas
    # `forge.yml` asks for an approval. Configure it.
[% else %]
    # the deployment starts without approval, which is what `forge.yml` asks for.
[% endif %]
    environment: [[ job.environment | yaml_scalar ]]
[% endif %]
    steps:
      - name: Check out the repository
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
[% for step in job.steps %]

      - name: [[ step.name | yaml_scalar ]]
[% if step.workdir %]
        working-directory: [[ step.workdir | yaml_scalar ]]
[% endif %]
[% if step.env %]
        env:
[% for key, value in step.env.items() %]
          [[ key ]]: [[ value | yaml_scalar ]]
[% endfor %]
[% endif %]
        run: |
[% for line in step.run %]
          [[ line ]]
[% endfor %]
[% endfor %]
[% if not loop.last %]

[% endif %]
[% endfor %]
