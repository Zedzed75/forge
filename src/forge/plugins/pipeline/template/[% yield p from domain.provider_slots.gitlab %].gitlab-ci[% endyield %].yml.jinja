# =============================================================================
# .gitlab-ci.yml — chaîne d'intégration de « [[ service.name ]] »
# =============================================================================
# Fichier généré par forge. Ne l'éditez pas à la main : modifiez `forge.yml` à la
# racine du dépôt, puis relancez `forge generate` — ou `forge update --only
# pipeline` pour ne recevoir que les évolutions du gabarit.
#
# Ce fichier n'a pas été écrit domaine par domaine : chaque domaine déclaré dans
# `forge.yml` a dit lui-même quels outils il fallait lancer et dans quel
# répertoire. Ajouter une section à `forge.yml` ajoute donc un job ici, sans que
# ce gabarit change.
#
# Domaines pris en compte :
[% for domaine in domain.domains %]
#   - [[ domaine.title ]] ([[ domaine.name ]]) — [[ domaine.validator_count ]] commande(s) de validation[[ (', déploie ' ~ domaine.deploys|join(', ')) if domaine.deploys else '' ]]
[% endfor %]
[% if domain.undeployed %]
#
# Domaines SANS commande de déploiement — forge n'en invente aucune, ils sont
# donc absents des jobs de déploiement : [[ domain.undeployed | join(', ') ]].
[% endif %]
[% if domain.unknown_tools %]
#
# ATTENTION — forge ne sait pas installer : [[ domain.unknown_tools | join(', ') ]].
# Les étapes concernées échouent en le disant. Complétez-les.
[% endif %]
#
# Aucun identifiant n'est écrit ici : employez des variables protégées et
# masquées, définies dans les réglages du projet.
# =============================================================================

# Une image de base minimale : chaque job installe ce dont il a besoin, et rien
# d'autre. Une image « à tout faire » cacherait quel job dépend de quel outil.
image: [[ domain.runner | yaml_scalar ]]

stages:
  - valider
[% if domain.build_job %]
  - construire
[% endif %]
[% if domain.deploy_jobs %]
  - deployer
[% endif %]

# Une exécution par branche : un push qui en remplace un autre annule le
# précédent plutôt que de faire la queue derrière lui.
default:
  interruptible: true

workflow:
  rules:
[% if domain.trigger.on_pull_request %]
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
[% endif %]
[% for branche in domain.trigger.branches %]
    - if: $CI_COMMIT_BRANCH == "[[ branche ]]"
[% endfor %]
[% if domain.trigger.on_tag %]
    - if: $CI_COMMIT_TAG
[% endif %]
    - when: never
[% for job in domain.jobs %]

[[ job.key ]]:
  stage: [% if job.kind == "validate" %]valider[% elif job.kind == "build" %]construire[% else %]deployer[% endif %]

[% if job.needs %]
  needs:
[% for prealable in job.needs %]
    - [[ prealable ]]
[% endfor %]
[% endif %]
[% if job.environment %]
  environment:
    name: [[ job.environment | yaml_scalar ]]
[% endif %]
[% if job.default_branch_only or job.manual %]
  rules:
[% if job.default_branch_only %]
    # Ne part que depuis la branche par défaut : une demande de fusion ne
    # publie rien et ne déploie rien.
    - if: $CI_COMMIT_BRANCH == "[[ domain.default_branch ]]"
[% if job.manual %]
      # Approbation humaine avant la production. `allow_failure: false` est
      # indispensable : sans lui, un job manuel non lancé est considéré comme
      # réussi et le pipeline passe au vert sans avoir rien déployé.
      when: manual
      allow_failure: false
[% endif %]
    - when: never
[% else %]
    - when: manual
      allow_failure: false
[% endif %]
[% endif %]
  script:
[% for step in job.steps %]
    # [[ step.name ]]
[% for ligne in step.script %]
    - [[ ligne | yaml_scalar ]]
[% endfor %]
[% endfor %]
[% endfor %]
