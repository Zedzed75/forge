# =============================================================================
# .gitlab-ci.yml — integration chain of "[[ service.name ]]"
# =============================================================================
# File generated by forge. Do not edit it by hand: modify `forge.yml` at the root
# of the repository, then run `forge generate` again — or `forge update --only
# pipeline` to receive only the evolutions of the template.
#
# This file was not written domain by domain: each domain declared in `forge.yml`
# said itself which tools had to be run and in which directory. Adding a section
# to `forge.yml` therefore adds a job here, without this template changing.
#
# Domains taken into account:
[% for d in domain.domains %]
#   - [[ d.title ]] ([[ d.name ]]) — [[ d.validator_count ]] validation command(s)[[ (', deploys ' ~ d.deploys|join(', ')) if d.deploys else '' ]]
[% endfor %]
[% if domain.undeployed %]
#
# Domains WITHOUT a deployment command — forge invents none, so they are absent
# from the deployment jobs: [[ domain.undeployed | join(', ') ]].
[% endif %]
[% if domain.unknown_tools %]
#
# WARNING — forge does not know how to install: [[ domain.unknown_tools | join(', ') ]].
# The steps concerned fail saying so. Complete them.
[% endif %]
#
# No credential is written here: use protected and masked variables, defined in
# the settings of the project.
# =============================================================================

# A minimal base image: each job installs what it needs, and nothing else. A
# do-everything image would hide which job depends on which tool.
image: [[ domain.runner | yaml_scalar ]]

# The stage names are French and stay so deliberately: each job references its
# stage by this exact string, so they are identifiers of the generated file
# rather than prose.
stages:
  - valider
[% if domain.build_job %]
  - construire
[% endif %]
[% if domain.deploy_jobs %]
  - deployer
[% endif %]

# One run per branch: a push that replaces another cancels the previous one
# rather than queueing behind it.
default:
  interruptible: true

workflow:
  rules:
[% if domain.trigger.on_pull_request %]
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
[% endif %]
[% for branch in domain.trigger.branches %]
    - if: $CI_COMMIT_BRANCH == "[[ branch ]]"
[% endfor %]
[% if domain.trigger.on_tag %]
    - if: $CI_COMMIT_TAG
[% endif %]
    - when: never
[% for job in domain.jobs %]

[[ job.key ]]:
  stage: [% if job.kind == "validate" %]valider[% elif job.kind == "build" %]construire[% else %]deployer[% endif %]

[% if job.needs %]
  needs:
[% for prerequisite in job.needs %]
    - [[ prerequisite ]]
[% endfor %]
[% endif %]
[% if job.environment %]
  environment:
    name: [[ job.environment | yaml_scalar ]]
[% endif %]
[% if job.default_branch_only or job.manual %]
  rules:
[% if job.default_branch_only %]
    # Only starts from the default branch: a merge request publishes nothing and
    # deploys nothing.
    - if: $CI_COMMIT_BRANCH == "[[ domain.default_branch ]]"
[% if job.manual %]
      # Human approval before production. `allow_failure: false` is
      # indispensable: without it, a manual job that was never started is
      # considered successful and the pipeline goes green without having deployed
      # anything.
      when: manual
      allow_failure: false
[% endif %]
    - when: never
[% else %]
    - when: manual
      allow_failure: false
[% endif %]
[% endif %]
  script:
[% for step in job.steps %]
    # [[ step.name ]]
[% for line in step.script %]
    - [[ line | yaml_scalar ]]
[% endfor %]
[% endfor %]
[% endfor %]
