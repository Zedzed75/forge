# =============================================================================
# main.tf — call of the module for the "[[ env.name ]]" environment
# =============================================================================
# File generated by forge.
#
# The module is written once and called once per environment: that is what
# guarantees that dev and prod set up the same objects, give or take the values.
# The values themselves are in terraform.tfvars.
#
# Every argument is passed explicitly. Terraform reports loudly an argument the
# module does not declare; it says NOTHING about a variable declared and never
# passed — it simply takes its default value, and the divergence is never seen.
# =============================================================================

module "[[ domain.module_name ]]" {
  source = "../../[[ domain.module_dir ]]"

[[ env.module_arguments | hcl_args(indent=1) ]]
}
