# =============================================================================
# outputs.tf — outputs of the "[[ env.name ]]" environment
# =============================================================================
# File generated by forge.
#
# These outputs are the meeting point with the rest of the chain: it is through
#
#   terraform -chdir=environments/[[ env.name ]] output -raw namespace
#
# that a pipeline learns where to deploy, rather than copying a naming convention
# that would end up diverging.
# =============================================================================
[% for output in domain.outputs %]

[[ output.description | comment(width=76) ]]
output "[[ output.name ]]" {
  description = [[ output.description | hcl ]]
  value       = module.[[ domain.module_name ]].[[ output.name ]]
}
[% endfor %]
