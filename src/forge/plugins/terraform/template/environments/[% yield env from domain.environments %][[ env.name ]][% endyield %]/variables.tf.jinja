# =============================================================================
# variables.tf — inputs of the "[[ env.name ]]" root
# =============================================================================
# File generated by forge.
#
# These variables take up those of the module, plus what concerns the access to
# the cluster. The values of this environment are in terraform.tfvars; any
# non-secret variable can be overridden there, even those forge has not
# pre-filled.
#
# The secret variables have no default value and do not appear in
# terraform.tfvars: they are provided through TF_VAR_<name>.
# =============================================================================
[% for variable in domain.root_variables %]

[[ variable.description | comment(width=76) ]]
[% if variable.sensitive %]
# Secret value: provide it through TF_VAR_[[ variable.name ]].
[% endif %]
variable "[[ variable.name ]]" {
  description = [[ variable.description | hcl ]]
  type        = [[ variable.type ]]
[% if variable.has_default %]
  default     = [[ variable.default ]]
[% endif %]
[% if variable.sensitive %]
  sensitive   = true
[% endif %]
}
[% endfor %]
