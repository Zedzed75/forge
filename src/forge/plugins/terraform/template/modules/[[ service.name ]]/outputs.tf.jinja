# =============================================================================
# outputs.tf — what the module returns to its caller
# =============================================================================
# File generated by forge.
#
# The outputs are the contract of the module towards the rest of the chain: it is
# through "terraform output -raw namespace" that a pipeline learns where to
# deploy, without copying a naming convention that could drift.
#
# No output returns a secret value. A generated password stays in the state; the
# module only names the Secret that carries it.
# =============================================================================
[% for output in domain.outputs %]

[[ output.description | comment(width=76) ]]
output "[[ output.name ]]" {
  description = [[ output.description | hcl ]]
  value       = [[ output.value ]]
}
[% endfor %]
