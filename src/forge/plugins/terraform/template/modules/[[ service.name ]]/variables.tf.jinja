# =============================================================================
# variables.tf — inputs of the "[[ service.name ]]" module
# =============================================================================
# File generated by forge.
#
# Every variable carries its explanation twice, and that is not a redundancy:
# the comment addresses whoever reads the file, the "description" attribute
# whoever reads "terraform plan", the documentation generated by terraform-docs,
# or the error message of a missing variable.
#
# The variables with no default value are mandatory: Terraform demands them, and
# "-input=false" turns the omission into a clean failure rather than into a
# question left unanswered in a CI log.
# =============================================================================
[% for variable in domain.variables %]

[[ variable.description | comment(width=76) ]]
[% if variable.sensitive %]
# Secret value: no default value, and absent from terraform.tfvars.
# Provide it through the TF_VAR_[[ variable.name ]] environment variable.
[% endif %]
variable "[[ variable.name ]]" {
  description = [[ variable.description | hcl ]]
  type        = [[ variable.type ]]
[% if variable.has_default %]
  default     = [[ variable.default ]]
[% endif %]
[% if variable.sensitive %]
  sensitive   = true
[% endif %]
}
[% endfor %]
