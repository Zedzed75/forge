[# --------------------------------------------------------------------- #]
[# HCL comments are written with "#" and not "//": terraform fmt converts #]
[# the latter into the former, and "terraform fmt -check" is one of the    #]
[# validators of the domain.                                              #]
[# --------------------------------------------------------------------- #]
# =============================================================================
# versions.tf — versions required by the "[[ service.name ]]" module
# =============================================================================
# File generated by forge.
#
# A module declares the versions it needs; it never configures a provider. It is
# the calling root — environments/<env>/providers.tf — that decides which cluster
# is targeted. A "provider" block written here would make the module unusable
# elsewhere.
# =============================================================================

terraform {
  # Upper bound mandatory: an open constraint would let a future major version of
  # Terraform break this module without anything having been changed.
  required_version = "[[ domain.terraform_version ]]"

  required_providers {
[% for provider in domain.providers %]
    # [[ provider.reason ]]
    [[ provider.name ]] = {
      source  = "[[ provider.source ]]"
      version = "[[ provider.version ]]"
    }
[% if not loop.last %]

[% endif %]
[% endfor %]
  }
}
