{
  "annotations": {
    "list": []
  },
  "description": "Generated by forge for the boutique service. One panel per alert: what is watched is what is looked at. The expressions plot the quantity itself, not the alerting condition, so that the threshold crossing can be seen coming. Reference environment: dev.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Family availability. Associated alert: TargetDown.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "editorMode": "code",
          "expr": "up{job=\"boutique\"}",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "The target no longer answers the collector",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Family error_rate. Associated alert: HighErrorRate, threshold 0.2.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"boutique\", status=~\"5..\"}[5m]))\n  /\nsum(rate(http_requests_total{job=\"boutique\"}[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Too many responses in error",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Family latency. Associated alert: HighLatency, threshold 2.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95,\n  sum by (le) (rate(http_request_duration_seconds_bucket{job=\"boutique\"}[5m]))\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "The service answers too slowly",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Family saturation. Associated alert: MemoryNearLimit, threshold 0.9.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "editorMode": "code",
          "expr": "container_memory_working_set_bytes{namespace=\"boutique-dev\", container!=\"\"}\n  /\ncontainer_spec_memory_limit_bytes{namespace=\"boutique-dev\", container!=\"\"}",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "A container is approaching its memory limit",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Family saturation. Associated alert: HighCpuUsage, threshold 1.5.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (pod) (\n  rate(container_cpu_usage_seconds_total{namespace=\"boutique-dev\", container!=\"\"}[5m])\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "A pod is durably consuming a lot of CPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Family restarts. Associated alert: ContainerRestartLoop, threshold 3.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "editorMode": "code",
          "expr": "increase(\n  kube_pod_container_status_restarts_total{namespace=\"boutique-dev\"}[1h]\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "A container is restarting in a loop",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Family probe. Associated alert: ExternalProbeFailed.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "targets": [
        {
          "editorMode": "code",
          "expr": "probe_success{job=\"blackbox\"}",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "The service is no longer reachable from the outside",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Family probe. Associated alert: CertificateExpiringSoon, threshold 21.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "targets": [
        {
          "editorMode": "code",
          "expr": "(\n  probe_ssl_earliest_cert_expiry{job=\"blackbox\"} - time()\n) / 86400",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "A TLS certificate is approaching its expiry",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "forge",
    "boutique"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "boutique \u2014 dev",
  "uid": "boutique-dev",
  "version": 1
}
