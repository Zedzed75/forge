{
  "annotations": {
    "list": []
  },
  "description": "Genere par forge pour le service boutique. Un panneau par alerte : ce que l\u0027on surveille est ce que l\u0027on regarde. Les expressions tracent la grandeur elle-meme, pas la condition d\u0027alerte, pour que l\u0027on voie venir le franchissement du seuil. Environnement de reference : dev.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Famille availability. Alerte associee : BoutiqueCibleInjoignable.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "editorMode": "code",
          "expr": "up{job=\"boutique\"}",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "La cible ne repond plus au collecteur",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Famille error_rate. Alerte associee : BoutiqueTauxErreurEleve, seuil 0.2.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"boutique\", status=~\"5..\"}[5m]))\n  /\nsum(rate(http_requests_total{job=\"boutique\"}[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Trop de reponses en erreur",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Famille latency. Alerte associee : BoutiqueLatenceElevee, seuil 2.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95,\n  sum by (le) (rate(http_request_duration_seconds_bucket{job=\"boutique\"}[5m]))\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Le service repond trop lentement",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Famille saturation. Alerte associee : BoutiqueMemoireProcheDeLaLimite, seuil 0.9.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "editorMode": "code",
          "expr": "container_memory_working_set_bytes{namespace=\"boutique-dev\", container!=\"\"}\n  /\ncontainer_spec_memory_limit_bytes{namespace=\"boutique-dev\", container!=\"\"}",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Un conteneur approche de sa limite memoire",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Famille saturation. Alerte associee : BoutiqueCpuEleve, seuil 1.5.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (pod) (\n  rate(container_cpu_usage_seconds_total{namespace=\"boutique-dev\", container!=\"\"}[5m])\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Un pod consomme durablement beaucoup de CPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Famille restarts. Alerte associee : BoutiqueRedemarragesEnBoucle, seuil 3.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "editorMode": "code",
          "expr": "increase(\n  kube_pod_container_status_restarts_total{namespace=\"boutique-dev\"}[1h]\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Un conteneur redemarre en boucle",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Famille probe. Alerte associee : BoutiqueSondeExterneEnEchec.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "targets": [
        {
          "editorMode": "code",
          "expr": "probe_success{job=\"blackbox\"}",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Le service n\u0027est plus joignable de l\u0027exterieur",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Famille probe. Alerte associee : BoutiqueCertificatBientotExpire, seuil 21.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "targets": [
        {
          "editorMode": "code",
          "expr": "(\n  probe_ssl_earliest_cert_expiry{job=\"blackbox\"} - time()\n) / 86400",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Un certificat TLS approche de son expiration",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
