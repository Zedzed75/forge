# =============================================================================
# Makefile — everyday operations on the monitoring of "storefront"
# =============================================================================
# File generated by forge.
#
# Every target accepts the ENV variable:
#
#   make check ENV=dev
#   make test  ENV=prod
#   make all
#
# The equivalent raw promtool commands appear in the README, for the environments
# that have no make.
# =============================================================================

ENVIRONMENTS := dev prod
FAMILIES     := availability error_rate latency saturation restarts probe

# Default environment. Override it with ENV=<name> on the command line.
ENV          ?= dev

CONFIG       := prometheus/$(ENV)/prometheus.yml
RULES        := $(foreach f,$(FAMILIES),prometheus/$(ENV)/rules/$(f).yml)
TESTS        := $(foreach f,$(FAMILIES),tests/$(ENV)/$(f).yml)

.DEFAULT_GOAL := help
.PHONY: help check-env config rules test check all clean

help: ## Displays this help
	@echo "Available environments : $(ENVIRONMENTS)"
	@echo "Current environment    : $(ENV)"
	@echo "Rule families          : $(FAMILIES)"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-12s %s\n", $$1, $$2}'

check-env: ## Checks that ENV designates an existing environment
	@test -d "prometheus/$(ENV)" || { echo "unknown environment: $(ENV) (expected: $(ENVIRONMENTS))"; exit 1; }

config: check-env ## Validates the configuration of the collector
	promtool check config $(CONFIG)

rules: check-env ## Validates the syntax of the alerting rules
	promtool check rules $(RULES)

test: check-env ## Checks that the alerts really fire
	promtool test rules $(TESTS)

check: config rules test ## Chains the three checks on $(ENV)

all: ## Chains the checks on EVERY environment
	@for e in $(ENVIRONMENTS); do echo "== $$e =="; $(MAKE) --no-print-directory check ENV=$$e; done

clean: ## Deletes the data of a Prometheus started locally
	rm -rf data prometheus-data
