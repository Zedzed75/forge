# File generated by forge. The syntax follows that of .gitignore.
# =============================================================================

# Version control
.git/
.gitignore
.bzr/
.hg/
.svn/

# Temporary files and editor backups
*.swp
*.bak
*.tmp
*.orig
*~
.DS_Store

# Editors and development environments
.idea/
.vscode/
.project
.vs/

# Repository tooling, of no interest in a chart archive
Makefile
.github/
.gitlab-ci.yml
