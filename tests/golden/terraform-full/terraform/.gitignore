# =============================================================================
# .gitignore — artefacts that must never be versioned
# =============================================================================
# File generated by forge.
#
# The first section is the most important one: the Terraform state carries IN
# PLAIN TEXT everything the resources expose, generated passwords and private
# keys included. A committed state is a leak, not a slip.
# =============================================================================

# Terraform state and its backups
*.tfstate
*.tfstate.*
*.tfstate.backup

# Working directory: downloaded providers, resolved modules, workspace lock.
# Rebuilt by "terraform init".
.terraform/

# Saved plans: a plan file contains the complete state, in plain text.
*.tfplan
plan.out

# Values files containing real values. The terraform.tfvars generated by forge,
# for their part, are versioned: they carry no secret.
*.auto.tfvars
terraform.tfvars.local
secrets.tfvars

# Logs
crash.log
crash.*.log

# Cluster access configuration
kubeconfig
*.kubeconfig

# Editors and file systems
.idea/
.vscode/
.DS_Store
*~
*.swp
