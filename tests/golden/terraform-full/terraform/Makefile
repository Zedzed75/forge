# =============================================================================
# Makefile — everyday operations on the Terraform base of "boutique"
# =============================================================================
# File generated by forge.
#
# Every target accepts the ENV variable, which selects the environment root:
#
#   make init  ENV=dev
#   make plan  ENV=prod
#   make apply ENV=prod
#
# The equivalent raw terraform commands appear in the README, for the
# environments that have no make.
# =============================================================================

ENVIRONMENTS := dev staging prod
# Default environment. Override it with ENV=<name> on the command line.
ENV          ?= dev

ROOT         := environments/$(ENV)
MODULE       := modules/boutique

.DEFAULT_GOAL := help
.PHONY: help check-env init plan apply destroy fmt fmt-fix validate lint output clean

help: ## Displays this help
	@echo "Available environments : $(ENVIRONMENTS)"
	@echo "Current environment    : $(ENV)"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-12s %s\n", $$1, $$2}'

check-env: ## Checks that ENV designates an existing root
	@test -d "$(ROOT)" || { echo "unknown environment: $(ENV) (expected: $(ENVIRONMENTS))"; exit 1; }

init: check-env ## Initialises the root (providers and state backend)
	terraform -chdir=$(ROOT) init -input=false

plan: check-env ## Shows what would be modified, without applying anything
	terraform -chdir=$(ROOT) plan -input=false

apply: check-env ## Applies the plan, after interactive confirmation
	terraform -chdir=$(ROOT) apply -input=false

destroy: check-env ## Destroys the base. WARNING: takes the namespace and ALL its content
	@echo "WARNING: destroying the namespace takes with it what was deployed there"
	@echo "by other tools (Helm charts included) and that Terraform does not know about."
	terraform -chdir=$(ROOT) destroy -input=false

fmt: ## Checks the canonical formatting of the whole project
	terraform fmt -check -recursive -diff

fmt-fix: ## Puts the whole project back into canonical form
	terraform fmt -recursive

validate: check-env ## Validates the configuration of the root (requires a prior init)
	terraform -chdir=$(ROOT) validate

lint: ## Runs tflint over the whole project
	tflint --recursive

output: check-env ## Displays the outputs of the root
	terraform -chdir=$(ROOT) output

clean: ## Deletes the terraform working directories
	rm -rf $(ROOT)/.terraform $(MODULE)/.terraform
