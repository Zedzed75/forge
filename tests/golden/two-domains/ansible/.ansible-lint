---
# ---------------------------------------------------------------------------
# .ansible-lint — configuration of the Ansible linter
# ---------------------------------------------------------------------------
# Full check of the project:
#   ansible-lint
# The "production" profile is the strictest one: it mandates fully qualified
# module names (FQCN), an explicit name on every task and documented roles.
#
# File generated by forge from forge.yml.
# Regenerate the project rather than editing this file by hand.
# ---------------------------------------------------------------------------

profile: production

exclude_paths:
  - .venv/
  - .github/
  # copier answers file: this is the plumbing of the generation, not Ansible
  # code. Its layout is copier's, not the project's.
  - .copier-answers.yml

# The default rules are enough: none is disabled in this project.
skip_list: []
