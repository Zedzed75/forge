# ---------------------------------------------------------------------------
# .gitignore — files that must never be committed
# ---------------------------------------------------------------------------
# File generated by forge from forge.yml.
# Regenerate the project rather than editing this file by hand.
# ---------------------------------------------------------------------------

# Vault password: must never enter the Git history.
.vault_pass
*.vault_pass

# Retry files written by ansible when a run fails.
*.retry

# Local artefacts.
.venv/
__pycache__/
*.log
