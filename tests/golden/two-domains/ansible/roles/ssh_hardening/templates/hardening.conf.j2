# File managed by Ansible (ssh_hardening role) - manual changes overwritten.
#
# These directives are read after /etc/ssh/sshd_config. On OpenSSH, it is the
# FIRST value encountered that wins: the "Include" line placed at the top of
# the main file therefore guarantees that this file takes precedence.

# Listening port of the server.
Port {{ ssh_hardening_port }}

# Direct login of the root account.
PermitRootLogin {{ ssh_hardening_permit_root_login }}

# Password authentication.
PasswordAuthentication {{ 'yes' if ssh_hardening_password_authentication else 'no' }}
KbdInteractiveAuthentication {{ 'yes' if ssh_hardening_password_authentication else 'no' }}

# Public key authentication.
PubkeyAuthentication {{ 'yes' if ssh_hardening_pubkey_authentication else 'no' }}

# X11 graphical forwarding.
X11Forwarding {{ 'yes' if ssh_hardening_x11_forwarding else 'no' }}

# Number of authentication attempts per connection.
MaxAuthTries {{ ssh_hardening_max_auth_tries }}

{% if ssh_hardening_allow_groups | length > 0 %}
# Only the members of these groups may log in.
AllowGroups {{ ssh_hardening_allow_groups | join(' ') }}

{% endif %}
# Additional hardening settings.
PermitEmptyPasswords no
IgnoreRhosts yes
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2
